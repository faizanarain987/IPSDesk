
@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavManager

<div class="search-bar" style="position: relative; display: flex; align-items: center; width: 100%; max-width: 320px;">
    <div style="position: absolute; left: 14px; color: #9CA3AF; pointer-events: none; display: flex;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </div>
    <input type="text" class="form-control" placeholder="Search by Id or Name..." 
           style="width: 100%; margin-bottom: 0; padding: 10px 16px 10px 42px; border-radius: 9999px; border: 1px solid #E5E7EB; background-color: #F9FAFB; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); font-size: 0.95rem; transition: all 0.2s ease;" 
           @bind="SearchQuery" @bind:event="oninput" @onfocus="() => showDropdown = true" />
    
    @if (showDropdown && !string.IsNullOrWhiteSpace(SearchQuery))
    {
        <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 40;" @onclick="() => showDropdown = false"></div>
        <div style="position: absolute; top: 100%; left: 0; width: 100%; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border: 1px solid var(--border-glass); border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1); z-index: 100; max-height: 350px; overflow-y: auto; margin-top: 12px; padding: 8px 0;">
            @if (isSearching)
            {
                <div style="padding: 12px 16px; color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 1s linear infinite;"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
                    Searching...
                </div>
            }
            else if (searchResults == null || !searchResults.Any())
            {
                <div style="padding: 12px 16px; color: var(--text-secondary); font-size: 0.85rem;">No customers found.</div>
            }
            else
            {
                @foreach (var customer in searchResults)
                {
                    <div style="padding: 12px 16px; cursor: pointer; border-bottom: 1px solid #F3F4F6; transition: background-color 0.2s;"
                         @onmousedown="() => NavigateToCustomer(customer.Id)"
                         onmouseover="this.style.backgroundColor='#F9FAFB'"
                         onmouseout="this.style.backgroundColor='transparent'">
                        <div style="font-weight: 600; color: #111827; display: flex; align-items: center; justify-content: space-between;">
                            <span>@customer.Name</span>
                            <span style="font-weight: 500; font-size: 0.75rem; color: #6B7280; background: #F3F4F6; padding: 2px 8px; border-radius: 999px;">@customer.ConnectionId</span>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private string _searchQuery = "";
    private string SearchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                _ = PerformSearch();
            }
        }
    }
    
    private bool showDropdown = false;
    private bool isSearching = false;
    private List<Customer>? searchResults;

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            searchResults = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        isSearching = true;
        await InvokeAsync(StateHasChanged);

        var query = SearchQuery.ToLower();
        
        using var scope = ServiceProvider.CreateScope();
        var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        
        searchResults = await context.Customers
            .Where(c => c.ConnectionId.ToLower().Contains(query) || c.Name.ToLower().Contains(query))
            .Take(10)
            .ToListAsync();
            
        isSearching = false;
        await InvokeAsync(StateHasChanged);
    }
    


    private void NavigateToCustomer(Guid id)
    {
        showDropdown = false;
        _searchQuery = "";
        searchResults = null;
        // Ensure navigation actually triggers a refresh if we're already on a profile page
        NavManager.NavigateTo($"/customers/billinghub/{id}", forceLoad: true);
    }
}
