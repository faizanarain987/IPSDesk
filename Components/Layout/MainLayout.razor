@inherits LayoutComponentBase
@using IPSDesk.Components.UI

<ToastContainer />

<div class="app-container">
    <div class="sidebar">
        <div class="sidebar-brand">
            Diamond ISP
        </div>
        <NavMenu />
    </div>

    <main class="main-content">
        <header class="top-bar">
            <div class="search-bar">
                <input type="text" class="form-control" placeholder="Search by Id" style="width: 300px; margin-bottom: 0; border-color: rgba(0, 0, 0, 0.2);" />
            </div>
            <div class="user-profile">
                <span style="color: var(--text-secondary);">Logged in User</span>
            </div>
        </header>

        <article class="page-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" style="display: none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
