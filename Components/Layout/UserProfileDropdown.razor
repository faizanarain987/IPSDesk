
@using IPSDesk.Models
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager NavigationManager

<div class="user-profile-dropdown-container">
    <button class="user-profile-trigger" @onclick="ToggleDropdown">
        <div class="avatar-circle">
            <span>@initials</span>
        </div>
        <span class="user-name">@fullName</span>
        <svg class="caret-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>

    @if (isDropdownOpen)
    {
        <div class="dropdown-backdrop" @onclick="ToggleDropdown"></div>
        <div class="profile-dropdown-menu">
            <div class="profile-dropdown-header">
                <div class="profile-name">@fullName</div>
                <div class="profile-email">@email</div>
                <span class="profile-role-badge" style="background-color: @(role == "Admin" ? "#D1FAE5" : "#DBEAFE"); color: #1E293B;">@role</span>
            </div>
            <div class="dropdown-divider"></div>
            <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Account.ChangePassword">
                <Authorized>
                    <a @onclick="NavigateToChangePassword" class="dropdown-item" style="cursor: pointer;">
                        <svg class="dropdown-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        Change Password
                    </a>
                </Authorized>
            </AuthorizeView>
            <form action="/logout" method="post" style="margin: 0;">
                <AntiforgeryToken />
                <button type="submit" class="dropdown-item logout-button">
                    <svg class="dropdown-item-icon logout-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    Logout
                </button>
            </form>
        </div>
    }
</div>

<style>
    .user-profile-dropdown-container {
        position: relative;
        display: inline-block;
    }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 999;
        background: transparent;
    }

    .user-profile-trigger {
        display: flex;
        align-items: center;
        gap: 10px;
        background: transparent;
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 8px;
        padding: 6px 14px;
        cursor: pointer;
        color: #1E293B;
        font-weight: 500;
        font-size: 0.95rem;
        transition: background-color 0.2s, border-color 0.2s;
    }

    .user-profile-trigger:hover {
        background: rgba(0, 0, 0, 0.03);
        border-color: rgba(0, 0, 0, 0.25);
    }

    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #3B82F6; /* Premium brand blue color */
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9rem;
        color: white;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .user-name {
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @@media (max-width: 768px) {
        .user-name {
            display: none;
        }
    }

    .caret-icon {
        color: #94A3B8;
    }

    .profile-dropdown-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(0,0,0,0.08);
        width: 240px;
        z-index: 1000;
        overflow: hidden;
        animation: fadeIn 0.15s ease-out;
    }

    .profile-dropdown-header {
        padding: 16px;
        background-color: #F8FAFC;
    }

    .profile-name {
        font-weight: 600;
        color: #1E293B;
        font-size: 0.95rem;
        margin-bottom: 2px;
    }

    .profile-email {
        color: #64748B;
        font-size: 0.85rem;
        word-break: break-all;
        margin-bottom: 8px;
    }

    .profile-role-badge {
        display: inline-block;
        background-color: #E2E8F0;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .dropdown-divider {
        height: 1px;
        background-color: #E2E8F0;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 12px 16px;
        color: #475569;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        border: none;
        background: none;
        text-align: left;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s;
    }

    .dropdown-item:hover {
        background-color: #F1F5F9;
        color: #0F172A;
    }

    .logout-button {
        color: #EF4444;
    }

    .logout-button:hover {
        background-color: #FEF2F2;
        color: #DC2626;
    }

    .dropdown-item-icon {
        color: #94A3B8;
        transition: color 0.2s;
    }

    .dropdown-item:hover .dropdown-item-icon {
        color: #64748B;
    }

    .logout-button:hover .logout-icon {
        color: #EF4444;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private string fullName = "Logged in User";
    private string email = "";
    private string role = "Employee";
    private string initials = "U";
    private bool isDropdownOpen = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var appUser = await userManager.GetUserAsync(user);
            if (appUser != null)
            {
                fullName = appUser.FullName ?? "User";
                email = appUser.Email ?? "";
                initials = string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper();
                
                var roles = await userManager.GetRolesAsync(appUser);
                role = roles.FirstOrDefault() ?? "Manager";
            }
        }
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void NavigateToChangePassword()
    {
        isDropdownOpen = false;
        NavigationManager.NavigateTo("/change-password");
    }
}
