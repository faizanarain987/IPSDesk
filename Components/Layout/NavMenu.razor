<div class="nav-links">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="HandleClick">
                <span>Dashboard</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <NavLink class="nav-item" href="customers" Match="NavLinkMatch.All" @onclick="HandleClick">
        <span>Customers</span>
    </NavLink>
    <NavLink class="nav-item" href="packages" @onclick="HandleClick">
        <span>Packages</span>
    </NavLink>
    
    <NavLink class="nav-item" href="customers/billinghub" @onclick="HandleClick">
        <span>Billing Hub</span>
    </NavLink>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <NavLink class="nav-item" href="renewals/history" @onclick="HandleClick">
                <span>Renewal History</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    
    <NavLink class="nav-item" href="payments" Match="NavLinkMatch.All" @onclick="HandleClick">
        <span>Payment History</span>
    </NavLink>
    <NavLink class="nav-item" href="payment-methods" @onclick="HandleClick">
        <span>Payment Methods</span>
    </NavLink>
    <NavLink class="nav-item" href="employees" @onclick="HandleClick">
        <span>Employees</span>
    </NavLink>
    <NavLink class="nav-item" href="reports" @onclick="HandleClick">
        <span>Reports</span>
    </NavLink>
</div>

@code {
    [Parameter]
    public EventCallback OnNavLinkClicked { get; set; }

    private async Task HandleClick()
    {
        if (OnNavLinkClicked.HasDelegate)
        {
            await OnNavLinkClicked.InvokeAsync();
        }
    }
}
