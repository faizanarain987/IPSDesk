<div class="nav-links">
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Dashboard.View">
        <Authorized>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="HandleClick">
                <span>Dashboard</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <NavLink class="nav-item" href="customers" Match="NavLinkMatch.All" @onclick="HandleClick">
        <span>Customers</span>
    </NavLink>
    <NavLink class="nav-item" href="packages" @onclick="HandleClick">
        <span>Packages</span>
    </NavLink>
    
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Customers.BillingHub">
        <Authorized>
            <NavLink class="nav-item" href="customers/billinghub" @onclick="HandleClick">
                <span>Billing Hub</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Renewals.ViewHistory">
        <Authorized>
            <NavLink class="nav-item" href="renewals/history" @onclick="HandleClick">
                <span>Renewal History</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Payments.ViewHistory">
        <Authorized>
            <NavLink class="nav-item" href="payments" Match="NavLinkMatch.All" @onclick="HandleClick">
                <span>Payment History</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.PaymentMethods.View">
        <Authorized>
            <NavLink class="nav-item" href="payment-methods" @onclick="HandleClick">
                <span>Payment Methods</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Users.View">
        <Authorized>
            <NavLink class="nav-item" href="employees" @onclick="HandleClick">
                <span>Employees</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Reports.View">
        <Authorized>
            <NavLink class="nav-item" href="reports" @onclick="HandleClick">
                <span>Reports</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Settings.View">
        <Authorized>
            <NavLink class="nav-item" href="settings" @onclick="HandleClick">
                <span>Settings</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Roles.Manage">
        <Authorized>
            <NavLink class="nav-item" href="roles" @onclick="HandleClick">
                <span>Roles & Permissions</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Parameter]
    public EventCallback OnNavLinkClicked { get; set; }

    private async Task HandleClick()
    {
        if (OnNavLinkClicked.HasDelegate)
        {
            await OnNavLinkClicked.InvokeAsync();
        }
    }
}
