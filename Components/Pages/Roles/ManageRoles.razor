@page "/roles"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using IPSDesk.Models
@using System.Reflection
@attribute [Authorize(Policy = AppPermissions.Roles.Manage)]
@inject RoleManager<IdentityRole> RoleManager
@inject IPSDesk.Services.ToastService ToastService
@inject NavigationManager NavManager

<PageTitle>Manage Roles - Diamond Net</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; padding: 32px; position: relative; overflow: hidden; border-top: 4px solid var(--accent-primary); background: linear-gradient(145deg, #ffffff, #f8fafc);">
    <div class="responsive-flex" style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(59, 130, 246, 0.1); color: var(--accent-primary); padding: 12px; border-radius: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <div>
                <h1 style="margin: 0; font-weight: 700; font-size: 1.5rem;">Roles & Permissions</h1>
                <p style="color: var(--text-secondary); margin: 4px 0 0 0; font-size: 0.95rem;">Manage system roles and their specific access rights.</p>
            </div>
        </div>
        <div class="responsive-flex" style="display: flex; gap: 16px; align-items: center;">
            <button class="btn-primary" style="padding: 12px 24px; font-weight: 600; border-radius: 8px; display: flex; align-items: center; gap: 8px;" @onclick='() => NavManager.NavigateTo("/roles/add")'>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Create Role
            </button>
        </div>
    </div>
</div>

<div class="glass-panel" style="padding: 0; display: flex; flex-direction: column; overflow: hidden;">
    <div class="table-scroll-wrapper">
    <table class="premium-table">
        <thead>
            <tr>
                <th>Role Name</th>
                <th>Permissions Count</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (roles == null)
            {
                <tr>
                    <td colspan="3" style="text-align: center; color: var(--text-secondary); padding: 24px;">Loading roles...</td>
                </tr>
            }
            else if (!roles.Any())
            {
                <tr>
                    <td colspan="3" style="text-align: center; color: var(--text-secondary); padding: 24px;">No roles found.</td>
                </tr>
            }
            else
            {
                @foreach (var role in displayedRoles)
                {
                    <tr>
                        <td style="font-weight: 500; color: var(--text-primary);">@role.Role.Name</td>
                        <td style="color: #4B5563;">
                            <span style="background: #e0e7ff; color: #4338ca; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                                @role.PermissionCount Rights
                            </span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                @if (role.Role.Name != "Admin")
                                {
                                    <button class="btn-icon btn-edit" style="color: var(--text-primary);" @onclick='() => NavManager.NavigateTo($"/roles/edit/{role.Role.Id}")' title="Edit Role">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button class="btn-icon btn-delete" style="color: var(--text-primary);" @onclick="() => ConfirmDeleteRole(role.Role)" title="Delete Role">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    <!-- Pagination Footer -->
    <div class="premium-pagination-footer">
        <div style="display: flex; align-items: center; gap: 12px; font-size: 0.85rem;">
            <span>Show</span>
            <select class="form-control" style="width: auto; padding: 4px 8px; margin-bottom: 0; font-size: 0.85rem;" @bind="pageSize" @bind:after="ResetPage">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="30">30</option>
                <option value="50">50</option>
            </select>
            <span>entries</span>
            <span style="margin-left: 16px;">
                Showing @(roles != null && roles.Any() ? ((currentPage - 1) * pageSize) + 1 : 0) to @(roles != null ? Math.Min(currentPage * pageSize, roles.Count()) : 0) of @(roles?.Count() ?? 0) entries
            </span>
        </div>
        
        @if (totalPages > 1)
        {
            <div style="display: flex; gap: 4px;">
                <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Prev</button>
                
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNum = i;
                    if (pageNum == currentPage)
                    {
                        <button class="btn-primary" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    else if (pageNum == 1 || pageNum == totalPages || (pageNum >= currentPage - 2 && pageNum <= currentPage + 2))
                    {
                        <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    else if (pageNum == currentPage - 3 || pageNum == currentPage + 3)
                    {
                        <span style="padding: 6px 4px; font-size: 0.85rem; color: var(--text-secondary);">...</span>
                    }
                }
                
                <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
            </div>
        }
    </div>
</div>

@if (isDeleteModalVisible && roleToDelete != null)
{
    <div class="modal-overlay">
        <div class="glass-panel" style="width: 100%; max-width: 500px; padding: 0; background: var(--bg-secondary); border-radius: 12px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid #E5E7EB;">
                <h2 style="margin: 0; font-size: 1.15rem; font-weight: 400; color: var(--text-primary);">Delete Role</h2>
                <button type="button" @onclick="HideDeleteModal" class="modal-close-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div style="padding: 32px 24px; text-align: left;">
                <p style="color: var(--text-secondary); margin: 0; font-size: 1.05rem;">
                    Are you sure you want to delete the role <strong style="color: var(--text-primary);">@roleToDelete.Name</strong>? Users assigned to this role may lose access.
                </p>
            </div>
            
            <div style="display: flex; justify-content: flex-end; gap: 12px; padding: 16px 24px; border-top: 1px solid #E5E7EB; background: var(--bg-secondary);">
                <button type="button" class="modal-cancel-btn" @onclick="HideDeleteModal">Cancel</button>
                <button type="button" class="modal-delete-btn" @onclick="DeleteRole">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<RoleViewModel>? roles;
    private bool isDeleteModalVisible = false;
    private IdentityRole? roleToDelete;
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => roles == null || !roles.Any() ? 1 : (int)Math.Ceiling((double)roles.Count() / pageSize);
    private IEnumerable<RoleViewModel> displayedRoles => roles?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<RoleViewModel>();

    private void ResetPage()
    {
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        var dbRoles = await RoleManager.Roles.ToListAsync();
        roles = new List<RoleViewModel>();
        
        foreach (var r in dbRoles)
        {
            var claims = await RoleManager.GetClaimsAsync(r);
            roles.Add(new RoleViewModel 
            { 
                Role = r, 
                PermissionCount = claims.Count(c => c.Type == "Permission") 
            });
        }
    }

    private void ConfirmDeleteRole(IdentityRole role)
    {
        if (role.Name == "Admin")
        {
            ToastService.ShowError("The Admin role cannot be deleted.");
            return;
        }
        
        roleToDelete = role;
        isDeleteModalVisible = true;
    }

    private void HideDeleteModal()
    {
        isDeleteModalVisible = false;
        roleToDelete = null;
    }

    private async Task DeleteRole()
    {
        if (roleToDelete == null) return;
        
        try
        {
            var result = await RoleManager.DeleteAsync(roleToDelete);
            if (result.Succeeded)
            {
                ToastService.ShowSuccess("Role deleted successfully.");
            }
            else
            {
                ToastService.ShowError("Failed to delete role.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting role: {ex.Message}");
        }
        
        HideDeleteModal();
        await LoadRoles();
    }

    public class RoleViewModel
    {
        public IdentityRole Role { get; set; } = new();
        public int PermissionCount { get; set; }
    }
}





