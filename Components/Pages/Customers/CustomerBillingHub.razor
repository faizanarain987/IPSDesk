@page "/customers/billinghub/{Id:guid}"
@page "/customers/billinghub"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject IPSDesk.Services.ToastService ToastService

<PageTitle>Customer Billing Hub - Diamond ISP</PageTitle>

@if (customer == null)
{
    <div style="display: flex; justify-content: center; align-items: center; min-height: 400px; flex-direction: column; gap: 16px;">
        @if (Id == Guid.Empty)
        {
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <h2 style="color: var(--text-primary); margin: 0; font-weight: 600;">Welcome to the Billing Hub</h2>
            <p style="color: var(--text-secondary); font-weight: 500; text-align: center; max-width: 400px; margin-bottom: 8px;">Please search for a customer below to manage their renewals and payments.</p>
            <div style="width: 100%; max-width: 400px; display: flex; justify-content: center; z-index: 50;">
                <IPSDesk.Components.UI.GlobalSearchBar />
            </div>
        }
        else
        {
            <div class="spinner" style="width: 48px; height: 48px; border-width: 4px;"></div>
            <p style="color: var(--text-secondary); font-weight: 500;">Loading Customer Data...</p>
        }
    </div>
}
else
{
    <!-- Customer Header Profile -->
    <div class="glass-panel" style="margin-bottom: 24px; padding: 32px; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 24px;">
        <!-- Subtle background accent -->
        <div style="position: absolute; top: 0; right: 0; width: 300px; height: 300px; background: radial-gradient(circle, var(--accent-primary) 0%, transparent 70%); opacity: 0.05; border-radius: 50%; transform: translate(30%, -30%); pointer-events: none;"></div>

        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 24px;">
            <div style="display: flex; align-items: center; gap: 24px;">
                <div style="width: 90px; height: 90px; border-radius: 24px; background: linear-gradient(135deg, var(--accent-primary), #8B5CF6); display: flex; align-items: center; justify-content: center; color: white; font-size: 2.5rem; font-weight: 700; box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4); transform: rotate(-5deg); transition: transform 0.3s ease;" onmouseover="this.style.transform='rotate(0deg)'" onmouseout="this.style.transform='rotate(-5deg)'">
                    @(string.IsNullOrEmpty(customer.Name) ? "?" : customer.Name.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <h1 style="margin: 0 0 8px 0; font-size: 2.2rem; font-weight: 800; letter-spacing: -0.5px; color: #111827;">@customer.Name</h1>
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <span style="font-family: monospace; font-size: 0.9rem; background: #F3F4F6; padding: 4px 10px; border-radius: 8px; color: #4B5563; font-weight: 600;">ID: @customer.ConnectionId</span>
                        <div style="display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 20px; background: @(customer.IsActive ? "rgba(16, 185, 129, 0.1)" : "rgba(239, 68, 68, 0.1)"); color: @(customer.IsActive ? "var(--accent-success)" : "var(--accent-danger)"); font-weight: 600; font-size: 0.85rem;">
                            <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; margin-right: 6px;"></span>
                            @(customer.IsActive ? "Active" : "Inactive")
                        </div>
                    </div>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; align-items: flex-end; background: #fff1f2; padding: 16px 24px; border-radius: 16px; border: 1px solid #ffe4e6; box-shadow: 0 4px 6px -1px rgba(225, 29, 72, 0.05);">
                <span style="color: #e11d48; font-size: 0.85rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px;">Outstanding Balance</span>
                <div style="font-size: 2.2rem; font-weight: 800; color: #be123c; display: flex; align-items: baseline; gap: 4px;">
                    <span style="font-size: 1.2rem; opacity: 0.8;">Rs.</span>
                    @customer.CurrentBalance.ToString("N0")
                </div>
            </div>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 32px; padding-top: 24px; border-top: 1px solid var(--border-glass);">
            <div>
                <span style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Current Package</span>
                <div style="font-weight: 600; color: var(--accent-primary); display: flex; align-items: center; gap: 6px; font-size: 1.05rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    @(customer.CurrentPackage?.Name ?? "None Assigned")
                </div>
            </div>
            <div>
                <span style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Phone Number</span>
                <div style="font-weight: 500; color: #1F2937;">@(string.IsNullOrEmpty(customer.Phone) ? "N/A" : customer.Phone)</div>
            </div>
            <div>
                <span style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Address</span>
                <div style="font-weight: 500; color: #1F2937; max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@customer.Address">@(string.IsNullOrEmpty(customer.Address) ? "N/A" : customer.Address)</div>
            </div>
            <div>
                <span style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Connection Date</span>
                <div style="font-weight: 500; color: #1F2937;">@customer.ConnectionDate.ToString("MMM dd, yyyy")</div>
            </div>
            <div>
                <button class="btn-icon" style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;" @onclick='() => NavManager.NavigateTo($"/customers/profile/{customer.Id}")'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    View Full Profile
                </button>
            </div>
        </div>
    </div>

    <!-- Action Forms Grid -->
    <div style="display: flex; flex-direction: column; gap: 24px; margin-bottom: 24px; max-width: 800px; margin-left: auto; margin-right: auto;">
        
        <!-- RENEW PACKAGE CARD -->
        <div class="glass-panel" style="padding: 0; overflow: hidden; border-top: 4px solid var(--accent-primary); display: flex; flex-direction: column;">
            <div style="padding: 24px; border-bottom: 1px solid var(--border-glass); background: #f8fafc; display: flex; align-items: center; gap: 12px;">
                <div style="background: rgba(99, 102, 241, 0.1); color: var(--accent-primary); padding: 10px; border-radius: 10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.59-9.21l5.94 4.5"/></svg>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: #111827;">Renew Package</h2>
                    <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary);">Charge customer for a new billing cycle.</p>
                </div>
            </div>
            <div style="padding: 24px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                <EditForm Model="this" FormName="renewPackageForm" OnValidSubmit="ProcessRenewal">
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; color: #374151;">Select Package</label>
                        <InputSelect @bind-Value="selectedPackageId" class="form-control" style="padding: 12px; font-size: 0.95rem; border-radius: 10px; border-color: #E5E7EB; background: #F9FAFB;">
                            @if (packages != null)
                            {
                                @foreach (var pkg in packages)
                                {
                                    <option value="@pkg.Id">@pkg.Name — Rs. @pkg.MonthlyPrice.ToString("N0")</option>
                                }
                            }
                        </InputSelect>
                    </div>
                    
                    <div style="margin-bottom: 32px;">
                        <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; color: #374151;">Billing Date</label>
                        <InputDate @bind-Value="renewalDate" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" style="width: 100%; padding: 12px; font-size: 0.95rem; border-radius: 10px; border-color: #E5E7EB; background: #F9FAFB;" />
                    </div>

                    <button type="submit" class="btn-primary" style="width: 100%; padding: 14px; font-size: 1rem; font-weight: 700; border-radius: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px 0 rgba(99, 102, 241, 0.4); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px 0 rgba(99, 102, 241, 0.5)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 14px 0 rgba(99, 102, 241, 0.4)';">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                         Renew Package
                    </button>
                </EditForm>
            </div>
        </div>

        <!-- RECORD PAYMENT CARD -->
        <div class="glass-panel" style="padding: 0; overflow: hidden; border-top: 4px solid var(--accent-success); display: flex; flex-direction: column;">
            <div style="padding: 24px; border-bottom: 1px solid var(--border-glass); background: #f8fafc; display: flex; align-items: center; gap: 12px;">
                <div style="background: rgba(16, 185, 129, 0.1); color: var(--accent-success); padding: 10px; border-radius: 10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: #111827;">Record Payment</h2>
                    <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary);">Receive cash to clear outstanding balance.</p>
                </div>
            </div>
            <div style="padding: 24px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                <EditForm Model="paymentModel" FormName="recordPaymentForm" OnValidSubmit="ProcessPayment">
                    <DataAnnotationsValidator />
                    <!-- Custom Items -->
                    <div style="margin-bottom: 24px; border: 1px solid var(--border-glass); border-radius: 12px; padding: 16px; background: white;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <label style="font-weight: 600; font-size: 0.9rem; color: #374151; margin: 0;">Items to Charge</label>
                            <button type="button" class="btn-secondary" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 8px;" @onclick="AddPaymentItem">
                                + Add Item
                            </button>
                        </div>
                        
                        @foreach (var item in paymentItems)
                        {
                            <div style="display: flex; gap: 8px; margin-bottom: 8px; align-items: center;">
                                <InputText @bind-Value="item.Description" placeholder="Description (e.g. Installation)" class="form-control" style="flex: 2; padding: 10px; font-size: 0.9rem; border-radius: 8px;" />
                                <InputNumber @bind-Value="item.Amount" placeholder="Amount" class="form-control" style="flex: 1; padding: 10px; font-size: 0.9rem; border-radius: 8px;" />
                                <button type="button" @onclick="() => RemovePaymentItem(item)" style="background: none; border: none; color: #EF4444; cursor: pointer; padding: 4px;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                        }
                        
                        <div style="display: flex; justify-content: space-between; margin-top: 16px; padding-top: 12px; border-top: 1px dashed #E5E7EB;">
                            <span style="font-weight: 500; color: var(--text-secondary); font-size: 0.9rem;">Subtotal:</span>
                            <span style="font-weight: 700; color: #111827;">Rs. @Subtotal.ToString("N0")</span>
                        </div>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; color: #374151;">Discount (Rs.)</label>
                            <InputNumber @bind-Value="paymentModel.Discount" class="form-control" style="padding: 12px; font-size: 0.95rem; border-radius: 10px; border-color: #E5E7EB; background: #F9FAFB;" />
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; color: #374151;">Total Charge (Rs.)</label>
                            <div style="padding: 12px; font-size: 1.1rem; font-weight: 700; color: var(--accent-primary); border-radius: 10px; background: rgba(99, 102, 241, 0.1);">
                                @TotalAmount.ToString("N0")
                            </div>
                        </div>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; color: #374151;">Amount Collected (Rs.)</label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--text-secondary);">Rs.</span>
                            <InputNumber @bind-Value="paymentModel.AmountCollected" class="form-control" style="padding: 12px 12px 12px 42px; font-size: 1.1rem; font-weight: 700; color: var(--accent-success); border-radius: 10px; border-color: #E5E7EB; background: #F9FAFB;" />
                        </div>
                    </div>
                    
                    <div style="margin-bottom: 32px;">
                        <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; color: #374151;">Payment Method</label>
                        <InputSelect @bind-Value="paymentModel.PaymentMethodId" class="form-control" style="padding: 12px; font-size: 0.95rem; border-radius: 10px; border-color: #E5E7EB; background: #F9FAFB;">
                            <option value="">-- Select Method --</option>
                            @if (paymentMethods != null)
                            {
                                @foreach (var pm in paymentMethods)
                                {
                                    <option value="@pm.Id">@pm.Name</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn-primary" style="width: 100%; padding: 14px; font-size: 1rem; font-weight: 700; border-radius: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px 0 rgba(16, 185, 129, 0.4); background-color: var(--accent-success); transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px 0 rgba(16, 185, 129, 0.5)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 14px 0 rgba(16, 185, 129, 0.4)';">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        Process Payment
                    </button>
                </EditForm>
            </div>
        </div>
    </div>


}

<style>
    .spinner {
        border-top-color: var(--accent-primary);
        animation: spin 1s ease-in-out infinite;
        border-radius: 50%;
        border-style: solid;
        border-color: rgba(0,0,0,0.1);
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Customer? customer;
    
    // Renewal Properties
    private List<Package>? packages;
    private Guid? selectedPackageId;
    private DateTime renewalDate = DateTime.Now;

    // Payment Properties
    private List<PaymentMethod>? paymentMethods;
    private Payment paymentModel = new();
    private List<PaymentItem> paymentItems = new();
    private decimal Subtotal => paymentItems.Sum(i => i.Amount);
    private decimal TotalAmount => Subtotal - paymentModel.Discount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        
        packages = await DbContext.Packages.Where(p => p.IsActive).OrderBy(p => p.MonthlyPrice).ToListAsync();
        paymentMethods = await DbContext.PaymentMethods.Where(m => m.IsActive).ToListAsync();
        
        var defaultMethod = paymentMethods.FirstOrDefault(m => m.IsDefault);
        if (defaultMethod != null)
        {
            paymentModel.PaymentMethodId = defaultMethod.Id;
        }
        
        paymentModel.BillingMonth = DateTime.Now.ToString("MMMM yyyy");
        
        if (!paymentItems.Any())
        {
            AddPaymentItem();
        }
    }
    
    private void AddPaymentItem()
    {
        paymentItems.Add(new PaymentItem());
    }
    
    private void RemovePaymentItem(PaymentItem item)
    {
        paymentItems.Remove(item);
    }

    private async Task LoadData()
    {
        if (Id == Guid.Empty)
        {
            return;
        }

        customer = await DbContext.Customers
            .Include(c => c.CurrentPackage)
            .Include(c => c.Payments)
                .ThenInclude(p => p.PaymentMethod)
            .Include(c => c.MonthlyHistory)
                .ThenInclude(h => h.Package)
            .Include(c => c.Ledgers)
            .FirstOrDefaultAsync(c => c.Id == Id);
            
        if (customer == null)
        {
            NavManager.NavigateTo("/customers");
            return;
        }

        if (selectedPackageId == null || selectedPackageId == Guid.Empty)
        {
            selectedPackageId = customer.CurrentPackageId;
        }
    }

    private async Task ProcessRenewal()
    {
        if (customer == null || selectedPackageId == null || selectedPackageId == Guid.Empty) return;

        var packageToCharge = packages?.FirstOrDefault(p => p.Id == selectedPackageId);
        if (packageToCharge == null) return;
        
        decimal expectedFee = packageToCharge.MonthlyPrice;
        string billingMonthString = renewalDate.ToString("MMMM yyyy");

        // Increase Debt
        customer.CurrentBalance += expectedFee;
        
        var feeLedger = new CustomerLedger
        {
            Id = Guid.NewGuid(),
            CustomerId = customer.Id,
            TransactionDate = DateTime.Now,
            Description = $"Monthly Package Charge ({packageToCharge.Name}) - {billingMonthString}",
            Debit = expectedFee,
            Credit = 0,
            Balance = customer.CurrentBalance
        };
        DbContext.CustomerLedgers.Add(feeLedger);
        
        var history = new MonthlyPackageHistory
        {
            CustomerId = customer.Id,
            PackageId = packageToCharge.Id,
            BillingMonth = billingMonthString,
            PackagePrice = expectedFee,
            AmountPaid = 0,
            RemainingBalance = customer.CurrentBalance,
            PaymentStatus = "Unpaid",
            RenewalDate = renewalDate
        };
        DbContext.MonthlyPackageHistories.Add(history);
        
        // Update Customer Profile if package changed
        if (customer.CurrentPackageId != selectedPackageId)
        {
            customer.CurrentPackageId = selectedPackageId;
        }
        
        DbContext.Customers.Update(customer);
        await DbContext.SaveChangesAsync();
        
        ToastService.ShowSuccess($"Package renewed successfully for {billingMonthString}.");
        
        // Reload data to reflect changes in UI
        await LoadData();
        StateHasChanged();
    }

    private async Task ProcessPayment()
    {
        if (customer == null || paymentModel.PaymentMethodId == Guid.Empty) return;

        // Auto-detect billing month if it's not set
        paymentModel.BillingMonth = renewalDate.ToString("MMMM yyyy");
        paymentModel.TotalCharge = TotalAmount;

        // Step 1: Charge the customer for the Items (TotalCharge)
        if (TotalAmount > 0)
        {
            customer.CurrentBalance += TotalAmount;
            
            var chargeLedger = new CustomerLedger
            {
                Id = Guid.NewGuid(),
                CustomerId = customer.Id,
                TransactionDate = DateTime.Now,
                Description = $"Custom Charge ({paymentItems.Count} items)",
                Debit = TotalAmount,
                Credit = 0,
                Balance = customer.CurrentBalance
            };
            DbContext.CustomerLedgers.Add(chargeLedger);
        }

        // Step 2: Collect the payment
        if (paymentModel.AmountCollected > 0)
        {
            customer.CurrentBalance -= paymentModel.AmountCollected;
            
            var paymentLedger = new CustomerLedger
            {
                Id = Guid.NewGuid(),
                CustomerId = customer.Id,
                TransactionDate = DateTime.Now,
                Description = "Payment Received",
                Debit = 0,
                Credit = paymentModel.AmountCollected,
                Balance = customer.CurrentBalance
            };
            DbContext.CustomerLedgers.Add(paymentLedger);
        }

        if (paymentModel.AmountCollected >= TotalAmount)
        {
            paymentModel.PaymentType = "Full Payment";
        }
        else
        {
            paymentModel.PaymentType = "Partial Payment";
        }
        
        paymentModel.CustomerId = customer.Id;
        paymentModel.PaymentDate = DateTime.Now;
        
        foreach (var item in paymentItems)
        {
            if (!string.IsNullOrWhiteSpace(item.Description) && item.Amount >= 0)
            {
                paymentModel.Items.Add(new PaymentItem
                {
                    Description = item.Description,
                    Amount = item.Amount
                });
            }
        }
        
        DbContext.Payments.Add(paymentModel);
        DbContext.Customers.Update(customer);
        
        await DbContext.SaveChangesAsync();
        
        ToastService.ShowSuccess("Payment recorded successfully.");
        
        NavManager.NavigateTo($"/payments/receipt/{paymentModel.Id}");
    }
}
