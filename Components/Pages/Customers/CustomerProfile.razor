@page "/customers/profile/{Id:guid}"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

<PageTitle>Customer Profile - Diamond Net</PageTitle>

@if (customer == null)
{
    <p>Loading...</p>
}
else
{
    <div class="glass-panel" style="margin-bottom: 24px; padding: 32px; position: relative; overflow: hidden;">
        <!-- Subtle background accent -->
        <div style="position: absolute; top: 0; right: 0; width: 300px; height: 300px; background: radial-gradient(circle, var(--accent-primary) 0%, transparent 70%); opacity: 0.05; border-radius: 50%; transform: translate(30%, -30%); pointer-events: none;"></div>

        <div style="display: flex; align-items: flex-start; gap: 24px;">
            <!-- Back Button & Avatar -->
            <div style="display: flex; align-items: center; gap: 16px;">
                <button class="btn-icon" style="color: var(--text-secondary); background: rgba(0,0,0,0.03); border: 1px solid var(--border-glass); border-radius: 50%; width: 40px; height: 40px;" @onclick='() => NavManager.NavigateTo("/customers")' title="Back to Customers">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                </button>
            </div>

            <!-- Profile Info -->
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div style="margin: 0 0 16px 0;">
                            <h1 style="margin: 0; font-size: 2.2rem; font-weight: 800; letter-spacing: -0.5px; color: var(--text-primary); text-transform: lowercase;">@customer.ConnectionId</h1>
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 1.15rem; color: var(--text-secondary); font-weight: 500; margin-top: 6px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                @customer.Name
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 24px;">
                            <div style="display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 20px; background: @(customer.IsActive ? "rgba(16, 185, 129, 0.1)" : "rgba(239, 68, 68, 0.1)"); color: @(customer.IsActive ? "var(--accent-success)" : "var(--accent-danger)"); font-weight: 600; font-size: 0.85rem;">
                                <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; margin-right: 6px;"></span>
                                @(customer.IsActive ? "Active Customer" : "Inactive")
                            </div>
                            <div style="display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 20px; background: #DBEAFE; color: #1E293B; font-weight: 600; font-size: 0.85rem; border: 1px solid rgba(0,0,0,0.05);">
                                @(customer.CurrentPackage?.Name ?? "No Package")
                                @if (IsPackageExpired)
                                {
                                    <span style="margin-left: 8px; background: #fee2e2; color: #ef4444; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: 700; text-transform: uppercase;">Expired</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div style="display: flex; gap: 16px; align-items: center;">
                        <div style="background: rgba(0,0,0,0.02); padding: 16px 24px; border-radius: 12px; border: 1px solid var(--border-glass); min-width: 150px;">
                            <span style="color: var(--text-secondary); font-size: 0.85rem; display: block; margin-bottom: 4px;">Current Balance</span>
                            <div style="display: flex; justify-content: flex-start; align-items: baseline; gap: 8px; font-weight: 700; font-size: 1.5rem; color: @(customer.CurrentBalance > 0 ? "var(--accent-danger)" : (customer.CurrentBalance < 0 ? "var(--accent-success)" : "var(--text-primary)"));">
                                <span style="font-size: 1rem; color: var(--text-secondary);">Rs.</span>
                                <span>@customer.CurrentBalance.ToString("N0")</span>
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button class="btn-success" @onclick='() => NavManager.NavigateTo($"/customers/billinghub/{customer.Id}")'>Renew Package</button>
                            <button class="btn-primary" @onclick='() => NavManager.NavigateTo($"/payments/new?connectionId={customer.ConnectionId}")'>Record Payment</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border-glass);">
            <div>
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Connection ID
                </span>
                <div style="font-weight: 500; margin-top: 4px;">@customer.ConnectionId</div>
            </div>
            <div> 
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    Email Address
                </span>
                <div style="font-weight: 500; margin-top: 4px; word-break: break-word;">@(string.IsNullOrEmpty(customer.Email) ? "N/A" : customer.Email)</div>
            </div>
            <div>
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    Phone Number
                </span>
                <div style="font-weight: 500; margin-top: 4px;">@(string.IsNullOrEmpty(customer.Phone) ? "N/A" : customer.Phone)</div>
            </div>
            <div>
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    WhatsApp
                </span>
                <div style="font-weight: 500; margin-top: 4px;">@(string.IsNullOrEmpty(customer.WhatsApp) ? "N/A" : customer.WhatsApp)</div>
            </div>
            <div>
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    CNIC Number
                </span>
                <div style="font-weight: 500; margin-top: 4px;">@(string.IsNullOrEmpty(customer.Cnic) ? "N/A" : customer.Cnic)</div>
            </div>

            <div>
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    Connection Date
                </span>
                <div style="font-weight: 500; margin-top: 4px;">@customer.ConnectionDate.ToString("MMM dd, yyyy")</div>
            </div>

            <div>
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                    Sector / Area / Zone
                </span>
                <div style="font-weight: 500; margin-top: 4px;">@(string.IsNullOrEmpty(customer.Area) ? "N/A" : customer.Area)</div>
            </div>
            <div style="grid-column: 1 / -1;">
                <span style="color: var(--text-secondary); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    Address
                </span>
                <div style="font-weight: 500; margin-top: 4px;">@(string.IsNullOrEmpty(customer.Address) ? "N/A" : customer.Address)</div>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(500px, 1fr)); gap: 24px;">
        <div class="glass-panel" style="min-width: 0; padding: 0; display: flex; flex-direction: column;">   
            <div style="padding: 24px; border-bottom: 1px solid var(--border-glass);">
                <h2 style="margin: 0;">Account Ledger</h2>
            </div>
            @if (!customer.Ledgers.Any())
            {
                <div style="padding: 24px;">
                    <p style="color: var(--text-secondary); margin: 0;">No ledger records yet.</p>
                </div>
            }
            else
            {
                <div class="table-scroll-wrapper">
                    <table class="premium-table" style="margin: 0; width: 100%; min-width: 600px;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Previous Balance</th>
                                <th>Charge (Debit)</th>
                                <th>Paid (Credit)</th>
                                <th>Balance</th>
                                <th>Processed By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ledger in displayedLedgers)
                            {
                                decimal prevBalance = ledger.Balance - ledger.Debit + ledger.Credit;
                                <tr>
                                    <td>@ledger.TransactionDate.ToString("MMM dd, yyyy")</td>
                                    <td>@ledger.Description</td>
                                    <td style="color: @(prevBalance > 0 ? "var(--accent-danger)" : (prevBalance < 0 ? "var(--accent-success)" : "var(--text-secondary)"));">Rs. @prevBalance.ToString("N0")</td>
                                    <td style="color: @(ledger.Debit > 0 ? "var(--accent-danger)" : "inherit");">@(ledger.Debit > 0 ? $"Rs. {ledger.Debit:N0}" : "-")</td>
                                    <td style="color: @(ledger.Credit > 0 ? "var(--accent-success)" : "inherit");">@(ledger.Credit > 0 ? $"Rs. {ledger.Credit:N0}" : "-")</td>
                                    <td style="font-weight: 600; color: @(ledger.Balance > 0 ? "var(--accent-danger)" : (ledger.Balance < 0 ? "var(--accent-success)" : "var(--text-primary)"));">Rs. @ledger.Balance.ToString("N0")</td>
                                    <td><span style="font-size: 0.85rem; color: var(--text-secondary); background: rgba(0,0,0,0.04); padding: 2px 8px; border-radius: 12px;">@(ledger.CreatedByName ?? "System")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Pagination Footer -->
                <div class="premium-pagination-footer">
                    <div style="display: flex; align-items: center; gap: 8px; color: var(--text-secondary); font-size: 0.85rem;">
                        <select class="form-control" style="width: auto; padding: 4px 8px; margin-bottom: 0; font-size: 0.85rem;" @bind="ledgerPageSize" @bind:after="ResetLedgerPage">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="30">30</option>
                            <option value="50">50</option>
                        </select>
                        <span>Showing @(sortedLedgers.Any() ? ((ledgerCurrentPage - 1) * ledgerPageSize) + 1 : 0) to @(Math.Min(ledgerCurrentPage * ledgerPageSize, sortedLedgers.Count())) of @(sortedLedgers.Count())</span>
                    </div>
                    @if (ledgerTotalPages > 1)
                    {
                        <div style="display: flex; gap: 4px;">
                            <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;" disabled="@(ledgerCurrentPage == 1)" @onclick="() => ledgerCurrentPage--">Prev</button>
                            <span style="padding: 4px 8px; font-size: 0.85rem; font-weight: 600;">@ledgerCurrentPage / @ledgerTotalPages</span>
                            <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;" disabled="@(ledgerCurrentPage == ledgerTotalPages)" @onclick="() => ledgerCurrentPage++">Next</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="glass-panel" style="min-width: 0; padding: 0; display: flex; flex-direction: column;">
            <div style="padding: 24px; border-bottom: 1px solid var(--border-glass);">
                <h2 style="margin: 0;">Monthly Package History</h2>
            </div>
            @if (!customer.MonthlyHistory.Any())
            {
                <div style="padding: 24px;">
                    <p style="color: var(--text-secondary); margin: 0;">No monthly history recorded yet.</p>
                </div>
            }
            else
            {
                <div class="table-scroll-wrapper">
                    <table class="premium-table" style="margin: 0; width: 100%; min-width: 500px;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Package</th>
                                <th>Discount</th>
                                <th>Amount</th>
                                <th>Date of Renew</th>
                                <th>Renewed By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int index = ((historyCurrentPage - 1) * historyPageSize) + 1; }
                            @foreach (var history in displayedHistory)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@(history.Package?.Name ?? "N/A")</td>
                                    <td>Rs. @history.Discount.ToString("N0")</td>
                                    <td>Rs. @history.PackagePrice.ToString("N0")</td>
                                    <td>@history.RenewalDate.ToString("MMM dd, yyyy")</td>
                                    <td><span style="font-size: 0.85rem; color: var(--text-secondary); background: rgba(0,0,0,0.04); padding: 2px 8px; border-radius: 12px;">@(history.CreatedByName ?? "System")</span></td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Pagination Footer -->
                <div class="premium-pagination-footer">
                    <div style="display: flex; align-items: center; gap: 8px; color: var(--text-secondary); font-size: 0.85rem;">
                        <select class="form-control" style="width: auto; padding: 4px 8px; margin-bottom: 0; font-size: 0.85rem;" @bind="historyPageSize" @bind:after="ResetHistoryPage">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="30">30</option>
                            <option value="50">50</option>
                        </select>
                        <span>Showing @(sortedHistory.Any() ? ((historyCurrentPage - 1) * historyPageSize) + 1 : 0) to @(Math.Min(historyCurrentPage * historyPageSize, sortedHistory.Count())) of @(sortedHistory.Count())</span>
                    </div>
                    @if (historyTotalPages > 1)
                    {
                        <div style="display: flex; gap: 4px;">
                            <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;" disabled="@(historyCurrentPage == 1)" @onclick="() => historyCurrentPage--">Prev</button>
                            <span style="padding: 4px 8px; font-size: 0.85rem; font-weight: 600;">@historyCurrentPage / @historyTotalPages</span>
                            <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;" disabled="@(historyCurrentPage == historyTotalPages)" @onclick="() => historyCurrentPage++">Next</button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Customer? customer;

    // Ledger Pagination
    private int ledgerCurrentPage = 1;
    private int ledgerPageSize = 10;
    private IEnumerable<CustomerLedger> sortedLedgers => customer?.Ledgers.OrderByDescending(l => l.TransactionDate) ?? Enumerable.Empty<CustomerLedger>();
    private int ledgerTotalPages => !sortedLedgers.Any() ? 1 : (int)Math.Ceiling((double)sortedLedgers.Count() / ledgerPageSize);
    private IEnumerable<CustomerLedger> displayedLedgers => sortedLedgers.Skip((ledgerCurrentPage - 1) * ledgerPageSize).Take(ledgerPageSize);

    private void ResetLedgerPage()
    {
        ledgerCurrentPage = 1;
    }

    // History Pagination
    private int historyCurrentPage = 1;
    private int historyPageSize = 10;
    private IEnumerable<MonthlyPackageHistory> sortedHistory => customer?.MonthlyHistory.OrderByDescending(h => h.RenewalDate) ?? Enumerable.Empty<MonthlyPackageHistory>();
    private int historyTotalPages => !sortedHistory.Any() ? 1 : (int)Math.Ceiling((double)sortedHistory.Count() / historyPageSize);
    private IEnumerable<MonthlyPackageHistory> displayedHistory => sortedHistory.Skip((historyCurrentPage - 1) * historyPageSize).Take(historyPageSize);

    private void ResetHistoryPage()
    {
        historyCurrentPage = 1;
    }

    private bool IsPackageExpired
    {
        get
        {
            if (customer == null || customer.CurrentPackageId == null) return false;
            var lastRenewal = customer.MonthlyHistory.OrderByDescending(h => h.RenewalDate).FirstOrDefault();
            if (lastRenewal == null) return true;
            
            return lastRenewal.RenewalDate.AddMonths(1).Date < DateTime.Now.Date;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        customer = await DbContext.Customers
            .Include(c => c.CurrentPackage)
            .Include(c => c.Payments)
                .ThenInclude(p => p.PaymentMethod)
            .Include(c => c.MonthlyHistory)
                .ThenInclude(h => h.Package)
            .Include(c => c.Ledgers)
            .FirstOrDefaultAsync(c => c.Id == Id);
            
        if (customer == null)
        {
            NavManager.NavigateTo("/customers");
        }
    }
}


