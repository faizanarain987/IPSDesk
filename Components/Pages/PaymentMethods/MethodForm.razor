@page "/payment-methods/add"
@page "/payment-methods/edit/{Id:guid}"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@using IPSDesk.Services
@inject ToastService ToastService

<PageTitle>@(Id.HasValue ? "Edit Payment Method" : "Add Payment Method") - Diamond ISP</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; padding: 32px; position: relative; overflow: hidden;">
    <div style="position: absolute; top: 0; right: 0; width: 300px; height: 300px; background: radial-gradient(circle, var(--accent-primary) 0%, transparent 70%); opacity: 0.05; border-radius: 50%; transform: translate(30%, -30%); pointer-events: none;"></div>

    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 32px;">
        <button class="btn-icon" style="color: var(--text-secondary); background: rgba(0,0,0,0.03); border: 1px solid var(--border-glass); border-radius: 50%; width: 40px; height: 40px;" @onclick='() => NavManager.NavigateTo("/payment-methods")' title="Back to Methods">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </button>
        <h1 style="margin: 0;">@(Id.HasValue ? "Edit Payment Method" : "Add New Payment Method")</h1>
    </div>

    @if (currentMethod == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <EditForm Model="@currentMethod" OnValidSubmit="SaveMethod" style="display: flex; flex-direction: column;">
            <DataAnnotationsValidator />
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
                <div>
                    <label>Method Name <span style="color: red;">*</span></label>
                    <InputText @bind-Value="currentMethod.Name" class="form-control" placeholder="e.g. JazzCash" />
                    <ValidationMessage For="@(() => currentMethod.Name)" />
                </div>
                <div>
                    <label style="display: block; margin-bottom: 8px;">Method Status</label>
                    <label class="toggle-switch">
                        <InputCheckbox @bind-Value="currentMethod.IsActive" />
                        <span class="toggle-slider"></span>
                    </label>
                    <span style="margin-left: 12px; font-weight: 500; vertical-align: super;">
                        @(currentMethod.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
                <div>
                    <label style="display: block; margin-bottom: 8px;">Default Method</label>
                    <label class="toggle-switch">
                        <InputCheckbox @bind-Value="currentMethod.IsDefault" />
                        <span class="toggle-slider" style="background-color: var(--accent-primary);"></span>
                    </label>
                    <span style="margin-left: 12px; font-weight: 500; vertical-align: super;">
                        @(currentMethod.IsDefault ? "Yes" : "No")
                    </span>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">Only one payment method can be default. Setting this will remove the default from others.</div>
                </div>
            </div>
            
            <div style="display: flex; justify-content: flex-end; gap: 16px; border-top: 1px solid var(--border-glass); padding-top: 24px;">
                <button type="button" class="btn-secondary" @onclick='() => NavManager.NavigateTo("/payment-methods")'>Cancel</button>
                <button type="submit" class="btn-primary">Save Method</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private PaymentMethod? currentMethod;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = await DbContext.PaymentMethods.FindAsync(Id.Value);
            if (existing != null)
            {
                currentMethod = new PaymentMethod
                {
                    Id = existing.Id,
                    Name = existing.Name,
                    IsActive = existing.IsActive,
                    IsDefault = existing.IsDefault
                };
            }
            else
            {
                NavManager.NavigateTo("/payment-methods");
            }
        }
        else
        {
            currentMethod = new PaymentMethod();
        }
    }

    private async Task SaveMethod()
    {
        if (currentMethod == null) return;

        // If this method is set to default, unset all others
        if (currentMethod.IsDefault)
        {
            var otherDefaults = await DbContext.PaymentMethods
                .Where(m => m.IsDefault && m.Id != currentMethod.Id)
                .ToListAsync();
                
            foreach(var m in otherDefaults)
            {
                m.IsDefault = false;
                DbContext.PaymentMethods.Update(m);
            }
        }

        if (currentMethod.Id == Guid.Empty)
        {
            currentMethod.Id = Guid.NewGuid();
            DbContext.PaymentMethods.Add(currentMethod);
        }
        else
        {
            var existing = await DbContext.PaymentMethods.FindAsync(currentMethod.Id);
            if (existing != null)
            {
                existing.Name = currentMethod.Name;
                existing.IsActive = currentMethod.IsActive;
                existing.IsDefault = currentMethod.IsDefault;
                DbContext.PaymentMethods.Update(existing);
            }
        }

        await DbContext.SaveChangesAsync();
        ToastService.ShowSuccess("Payment Method saved successfully!");
        NavManager.NavigateTo("/payment-methods");
    }
}
