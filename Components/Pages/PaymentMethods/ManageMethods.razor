@page "/payment-methods"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = IPSDesk.Models.AppPermissions.PaymentMethods.View)]

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

<PageTitle>Payment Methods - Diamond Net</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; padding: 32px; position: relative; overflow: hidden; border-top: 4px solid var(--accent-primary); background: linear-gradient(145deg, #ffffff, #f8fafc);">
    <div class="responsive-flex" style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(59, 130, 246, 0.1); color: var(--accent-primary); padding: 12px; border-radius: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            </div>
            <div>
                <h1 style="margin: 0; font-weight: 700; font-size: 1.5rem;">Payment Methods</h1>
                <p style="color: var(--text-secondary); margin: 4px 0 0 0; font-size: 0.95rem;">Manage available payment methods (Cash, Bank, Easypaisa, etc.).</p>
            </div>
        </div>
        <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.PaymentMethods.Create">
            <Authorized>
                <button class="btn-primary" style="padding: 12px 24px; font-weight: 600; border-radius: 8px; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.39);" @onclick='() => NavManager.NavigateTo("/payment-methods/add")'>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    New Method
                </button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="glass-panel" style="padding: 0; display: flex; flex-direction: column; overflow: hidden;">
    @if (methods == null)
    {
        <p style="padding: 24px; color: var(--text-secondary); text-align: center;">Loading...</p>
    }
    else if (!methods.Any())
    {
        <p style="padding: 24px; color: var(--text-secondary); text-align: center;">No payment methods found.</p>
    }
    else
    {
        <div class="table-scroll-wrapper">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Method Name</th>
                    <th>Default</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var method in displayedMethods)
                {
                    <tr>
                        <td style="font-weight: 500; color: var(--text-primary);">@method.Name</td>
                        <td>
                            <span style="display: inline-block; padding: 4px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; background-color: @(method.IsDefault ? "#D1FAE5" : "#FEF3C7"); color: @(method.IsDefault ? "#047857" : "#B45309"); border: 1px solid @(method.IsDefault ? "#34D399" : "#FBBF24");">
                                @(method.IsDefault ? "Yes" : "No")
                            </span>
                        </td>
                        <td>
                            <span style="display: inline-block; padding: 4px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; background-color: @(method.IsActive ? "#D1FAE5" : "#FEE2E2"); color: @(method.IsActive ? "#047857" : "#B91C1C"); border: 1px solid @(method.IsActive ? "#34D399" : "#F87171");">
                                @(method.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.PaymentMethods.Edit">
                                    <Authorized>
                                        <button class="btn-icon btn-edit" style="color: var(--text-primary);" @onclick='() => NavManager.NavigateTo($"/payment-methods/edit/{method.Id}")' title="Edit Details">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.PaymentMethods.Delete">
                                    <Authorized>
                                        <button class="btn-icon btn-delete" style="color: var(--text-primary);" @onclick="() => ConfirmDeleteMethod(method)" title="Delete">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <!-- Pagination Footer -->
        <div class="premium-pagination-footer">
            <div style="display: flex; align-items: center; gap: 12px; font-size: 0.85rem;">
                <span>Show</span>
                <select class="form-control" style="width: auto; padding: 4px 8px; margin-bottom: 0; font-size: 0.85rem;" @bind="pageSize" @bind:after="ResetPage">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                </select>
                <span>entries</span>
                <span style="margin-left: 16px;">
                    Showing @(methods != null && methods.Any() ? ((currentPage - 1) * pageSize) + 1 : 0) to @(methods != null ? Math.Min(currentPage * pageSize, methods.Count()) : 0) of @(methods?.Count() ?? 0) entries
                </span>
            </div>
            
            @if (totalPages > 1)
            {
                <div style="display: flex; gap: 4px;">
                    <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Prev</button>
                    
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        int pageNum = i;
                        if (pageNum == currentPage)
                        {
                            <button class="btn-primary" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        }
                        else if (pageNum == 1 || pageNum == totalPages || (pageNum >= currentPage - 2 && pageNum <= currentPage + 2))
                        {
                            <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        }
                        else if (pageNum == currentPage - 3 || pageNum == currentPage + 3)
                        {
                            <span style="padding: 6px 4px; font-size: 0.85rem; color: var(--text-secondary);">...</span>
                        }
                    }
                    
                    <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                </div>
            }
        </div>
    }
</div>

@if (isDeleteModalVisible && methodToDelete != null)
{
    <div class="modal-overlay">
        <div class="glass-panel" style="width: 100%; max-width: 500px; padding: 0; background: var(--bg-secondary); border-radius: 12px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid #E5E7EB;">
                <h2 style="margin: 0; font-size: 1.15rem; font-weight: 400; color: var(--text-primary);">Delete Payment Method</h2>
                <button type="button" @onclick="HideDeleteModal" class="modal-close-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <div style="padding: 32px 24px; text-align: left;">
                <p style="color: var(--text-secondary); margin: 0; font-size: 1.05rem;">
                    Are you sure you want to delete <strong style="color: var(--text-primary);">@methodToDelete.Name</strong>?
                </p>
            </div>
            
            <div style="display: flex; justify-content: flex-end; gap: 12px; padding: 16px 24px; border-top: 1px solid #E5E7EB; background: var(--bg-secondary);">
                <button type="button" class="modal-cancel-btn" @onclick="HideDeleteModal">Cancel</button>
                <button type="button" class="modal-delete-btn" @onclick="SoftDeleteMethod">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<PaymentMethod>? methods;
    private bool isDeleteModalVisible = false;
    private PaymentMethod? methodToDelete;
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => methods == null || !methods.Any() ? 1 : (int)Math.Ceiling((double)methods.Count() / pageSize);
    private IEnumerable<PaymentMethod> displayedMethods => methods?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<PaymentMethod>();

    private void ResetPage()
    {
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMethods();
    }

    private async Task LoadMethods()
    {
        methods = await DbContext.PaymentMethods
            .Where(m => !m.IsDeleted)
            .OrderByDescending(m => m.IsDefault)
            .ThenBy(m => m.Name)
            .ToListAsync();
    }

    private void ConfirmDeleteMethod(PaymentMethod method)
    {
        methodToDelete = method;
        isDeleteModalVisible = true;
    }

    private void HideDeleteModal()
    {
        isDeleteModalVisible = false;
        methodToDelete = null;
    }

    private async Task SoftDeleteMethod()
    {
        if (methodToDelete == null) return;
        
        methodToDelete.IsDeleted = true;
        DbContext.PaymentMethods.Update(methodToDelete);
        await DbContext.SaveChangesAsync();
        
        HideDeleteModal();
        await LoadMethods();
    }
}





