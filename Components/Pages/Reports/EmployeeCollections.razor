@page "/reports"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Collection Report - Diamond Net</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; padding: 32px; position: relative; overflow: hidden; border-top: 4px solid var(--accent-primary);">
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="background: rgba(59, 130, 246, 0.1); color: var(--accent-primary); padding: 12px; border-radius: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div>
            <h1 style="margin: 0; font-weight: 700; font-size: 1.5rem;">Collection Report</h1>
            <p style="color: var(--text-secondary); margin: 4px 0 0 0; font-size: 0.95rem;">View detailed collection history by specific employees over a date range.</p>
        </div>
    </div>
</div>

<div class="glass-panel" style="margin-bottom: 24px; position: relative; z-index: 100; overflow: visible;">
    <div class="responsive-flex" style="display: flex; gap: 16px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 200px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Select Employee</label>
            <div style="position: relative;" tabindex="0" @onblur="() => { _ = HideDropdown(); }">
                <div class="form-control" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; font-size: 1rem; border-radius: 8px; height: 46px; cursor: pointer; background: var(--bg-secondary);" @onclick="ToggleDropdown">
                    <span style="color: @(string.IsNullOrEmpty(selectedEmployeeId) ? "var(--text-secondary)" : "var(--text-primary)"); font-weight: 500;">
                        @(string.IsNullOrEmpty(selectedEmployeeId) ? "-- All Employees --" : employees?.FirstOrDefault(e => e.Id == selectedEmployeeId)?.FullName ?? "-- All Employees --")
                    </span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s; transform: @(isDropdownOpen ? "rotate(180deg)" : "rotate(0deg)")"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
                
                @if (isDropdownOpen)
                {
                    <div style="position: absolute; top: 100%; left: 0; right: 0; margin-top: 4px; background: var(--bg-secondary); border-radius: 8px; border: 1px solid var(--border-glass); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); z-index: 50; max-height: 250px; overflow-y: auto;">
                        <div class="custom-dropdown-item @(string.IsNullOrEmpty(selectedEmployeeId) ? "active" : "")" @onmousedown='() => SelectEmployee("")'>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--border-glass); display: flex; align-items: center; justify-content: center; color: #4B5563;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                </div>
                                <span>-- All Employees --</span>
                            </div>
                            @if (string.IsNullOrEmpty(selectedEmployeeId)) { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                        </div>
                        @if (employees != null)
                        {
                            @foreach (var emp in employees)
                            {
                                <div class="custom-dropdown-item @(selectedEmployeeId == emp.Id ? "active" : "")" @onmousedown='() => SelectEmployee(emp.Id)'>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 24px; height: 24px; border-radius: 50%; background: rgba(59, 130, 246, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); font-weight: 600; font-size: 0.7rem;">
                                            @(emp.FullName?.Substring(0, 1).ToUpper() ?? "E")
                                        </div>
                                        <span>@emp.FullName</span>
                                    </div>
                                    @if (selectedEmployeeId == emp.Id) { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">From Date</label>
            <input type="date" class="form-control" style="padding: 10px 12px; font-size: 1rem; border-radius: 8px; height: 46px;" @bind="startDate" />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">To Date</label>
            <input type="date" class="form-control" style="padding: 10px 12px; font-size: 1rem; border-radius: 8px; height: 46px;" @bind="endDate" />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; margin-bottom: 8px; visibility: hidden;">Action</label>
            <button class="btn-primary @(isLoading ? "is-loading" : "")" disabled="@isLoading" style="width: 100%; padding: 0 24px; font-weight: 600; font-size: 1rem; border-radius: 8px; height: 46px; box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.39);" @onclick="GenerateReport">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
                Generate Report
            </button>
        </div>
    </div>
</div>

@if (hasSearched)
{
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; margin-bottom: 24px;">
        <div class="glass-panel" style="border-left: 4px solid var(--accent-success);">
            <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">Total Collection</div>
            <div style="font-size: 2rem; font-weight: 700; margin-top: 8px; color: var(--accent-success);">Rs. @totalCollection.ToString("N0")</div>
        </div>
        <div class="glass-panel" style="border-left: 4px solid var(--accent-primary);">
            <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">Total Transactions</div>
            <div style="font-size: 2rem; font-weight: 700; margin-top: 8px;">@filteredPayments?.Count</div>
        </div>
    </div>

    <div class="glass-panel" style="padding: 0; display: flex; flex-direction: column; overflow: hidden;">
        <div style="padding: 24px; border-bottom: 1px solid var(--border-glass);">
            <h2 style="margin: 0; font-size: 1.1rem; font-weight: 600; color: var(--text-primary);">Collection Details</h2>
        </div>
        @if (filteredPayments == null || !filteredPayments.Any())
        {
            <div style="padding: 24px; color: var(--text-secondary); text-align: center;">No collections found for the selected criteria.</div>
        }
        else
        {
            <div class="table-scroll-wrapper">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Receipt No</th>
                        <th>Connection ID</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Collected By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in displayedPayments)
                    {
                        <tr>
                            <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                            <td style="font-family: monospace;">@p.ReceiptNumber</td>
                            <td style="color: var(--text-secondary);">@(p.Customer?.ConnectionId ?? "N/A")</td>
                            <td style="font-weight: 500;">@(p.Customer?.Name ?? "Unknown")</td>
                            <td style="font-weight: 600; color: var(--accent-success);">Rs. @p.AmountCollected.ToString("N0")</td>
                            <td><span style="font-size: 0.85rem; color: var(--text-secondary); background: rgba(0,0,0,0.04); padding: 2px 8px; border-radius: 12px;">@(p.CreatedByName ?? "System")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            <!-- Pagination Footer -->
            <div class="premium-pagination-footer">
                <div style="display: flex; align-items: center; gap: 12px; font-size: 0.85rem;">
                    <span>Show</span>
                    <select class="form-control" style="width: auto; padding: 4px 8px; margin-bottom: 0; font-size: 0.85rem;" @bind="pageSize" @bind:after="ResetPage">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                    </select>
                    <span>entries</span>
                    <span style="margin-left: 16px;">
                        Showing @(filteredPayments != null && filteredPayments.Any() ? ((currentPage - 1) * pageSize) + 1 : 0) to @(filteredPayments != null ? Math.Min(currentPage * pageSize, filteredPayments.Count()) : 0) of @(filteredPayments?.Count() ?? 0) entries
                    </span>
                </div>
                
                @if (totalPages > 1)
                {
                    <div style="display: flex; gap: 4px;">
                        <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">Prev</button>
                        
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            int pageNum = i;
                            if (pageNum == currentPage)
                            {
                                <button class="btn-primary" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                            }
                            else if (pageNum == 1 || pageNum == totalPages || (pageNum >= currentPage - 2 && pageNum <= currentPage + 2))
                            {
                                <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                            }
                            else if (pageNum == currentPage - 3 || pageNum == currentPage + 3)
                            {
                                <span style="padding: 6px 4px; font-size: 0.85rem; color: var(--text-secondary);">...</span>
                            }
                        }
                        
                        <button class="btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<ApplicationUser>? employees;
    private string selectedEmployeeId = "";
    private DateTime startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime endDate = DateTime.Now.Date;
    
    private bool hasSearched = false;
    private decimal totalCollection = 0;
    private List<Payment>? filteredPayments;
    private bool isLoading = false;
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => filteredPayments == null || !filteredPayments.Any() ? 1 : (int)Math.Ceiling((double)filteredPayments.Count() / pageSize);
    private IEnumerable<Payment> displayedPayments => filteredPayments?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<Payment>();

    // Dropdown Logic
    private bool isDropdownOpen = false;

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private async Task HideDropdown()
    {
        await Task.Delay(150);
        isDropdownOpen = false;
        StateHasChanged();
    }

    private void SelectEmployee(string id)
    {
        selectedEmployeeId = id;
        isDropdownOpen = false;
    }

    private void ResetPage()
    {
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        employees = await DbContext.Users.Where(u => !u.IsDeleted).ToListAsync();
        await GenerateReport();
    }

    private async Task GenerateReport()
    {
        isLoading = true;
        StateHasChanged();
        
        // Simulate network delay for effect
        await Task.Delay(400);

        // Adjust endDate to include the entire day if it's matching the exact date (00:00:00)
        var endDateIncluded = endDate.Date.AddDays(1).AddTicks(-1);

        var query = DbContext.Payments
            .Include(p => p.Customer)
            .Where(p => !p.IsDeleted && p.PaymentDate >= startDate.Date && p.PaymentDate <= endDateIncluded);
            
        if (!string.IsNullOrEmpty(selectedEmployeeId))
        {
            query = query.Where(p => p.CreatedById == selectedEmployeeId);
        }
        
        filteredPayments = await query.OrderByDescending(p => p.PaymentDate).ToListAsync();
        totalCollection = filteredPayments.Sum(p => p.AmountCollected);
        hasSearched = true;
        
        isLoading = false;
    }
}

<style>
    .custom-dropdown-item {
        padding: 10px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-primary);
        transition: background-color 0.15s, color 0.15s;
    }
    .custom-dropdown-item:hover {
        background-color: var(--bg-secondary);
        filter: brightness(0.95);
    }
    .custom-dropdown-item.active {
        background-color: rgba(59, 130, 246, 0.05);
        color: var(--accent-primary);
    }
</style>
