@page "/"
@rendermode InteractiveServer
@using IPSDesk.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Dashboard - Diamond ISP</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px;">
    <h1>Dashboard</h1>
    <p style="color: var(--text-secondary);">Overview of ISP performance and customer metrics.</p>
</div>

<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">
    <div class="glass-panel" style="border-left: 4px solid var(--accent-primary);">
        <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">Total Customers</div>
        <div style="font-size: 2rem; font-weight: 700; margin-top: 8px;">@totalCustomers</div>
    </div>
    
    <div class="glass-panel" style="border-left: 4px solid var(--accent-success);">
        <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">Active Connections</div>
        <div style="font-size: 2rem; font-weight: 700; margin-top: 8px;">@activeCustomers</div>
    </div>
    
    <div class="glass-panel" style="border-left: 4px solid var(--accent-warning);">
        <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">Total Outstanding</div>
        <div style="font-size: 2rem; font-weight: 700; margin-top: 8px; color: var(--accent-warning);">
            Rs. @totalOutstanding.ToString("N0")
        </div>
    </div>
    
    <div class="glass-panel" style="border-left: 4px solid #8b5cf6;">
        <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">Current Month Revenue</div>
        <div style="font-size: 2rem; font-weight: 700; margin-top: 8px; color: #8b5cf6;">
            Rs. @monthlyRevenue.ToString("N0")
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
    <div class="glass-panel">
        <h2>Customers by Package</h2>
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Package</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stat in packageStats)
                {
                    <tr>
                        <td>@stat.PackageName</td>
                        <td>@stat.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="glass-panel">
        <h2>Recent Payments</h2>
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in recentPayments)
                {
                    <tr>
                        <td>@payment.Date.ToString("MMM dd")</td>
                        <td>@payment.CustomerName</td>
                        <td style="color: var(--accent-success);">Rs. @payment.Amount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int totalCustomers;
    private int activeCustomers;
    private decimal totalOutstanding;
    private decimal monthlyRevenue;
    
    private List<PackageStat> packageStats = new();
    private List<RecentPayment> recentPayments = new();
    
    protected override async Task OnInitializedAsync()
    {
        totalCustomers = await DbContext.Customers.CountAsync();
        activeCustomers = await DbContext.Customers.CountAsync(c => c.IsActive);
        totalOutstanding = await DbContext.Customers.SumAsync(c => c.CurrentBalance);
        
        string currentMonth = DateTime.Now.ToString("MMMM yyyy");
        monthlyRevenue = await DbContext.Payments
            .Where(p => p.BillingMonth == currentMonth)
            .SumAsync(p => p.AmountCollected);
            
        var packages = await DbContext.Packages.ToListAsync();
        foreach(var pkg in packages)
        {
            int count = await DbContext.Customers.CountAsync(c => c.CurrentPackageId == pkg.Id && c.IsActive);
            if (count > 0)
            {
                packageStats.Add(new PackageStat { PackageName = pkg.Name, Count = count });
            }
        }
        
        recentPayments = await DbContext.Payments
            .Include(p => p.Customer)
            .OrderByDescending(p => p.PaymentDate)
            .Take(5)
            .Select(p => new RecentPayment 
            { 
                Date = p.PaymentDate, 
                CustomerName = p.Customer != null ? p.Customer.Name : "Unknown", 
                Amount = p.AmountCollected 
            })
            .ToListAsync();
    }
    
    private class PackageStat
    {
        public string PackageName { get; set; } = "";
        public int Count { get; set; }
    }
    
    private class RecentPayment
    {
        public DateTime Date { get; set; }
        public string CustomerName { get; set; } = "";
        public decimal Amount { get; set; }
    }
}
