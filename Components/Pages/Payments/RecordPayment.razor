@page "/payments/new"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

<PageTitle>Record Payment - Diamond Net</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; position: relative; z-index: 10; border-top: 4px solid var(--accent-success); background: linear-gradient(145deg, #ffffff, #f8fafc);">
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 8px;">
        <div style="background: rgba(16, 185, 129, 0.1); color: var(--accent-success); padding: 12px; border-radius: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div>
            <h1 style="margin: 0; font-weight: 700;">Record Payment</h1>
            <p style="color: var(--text-secondary); margin: 4px 0 0 0; font-size: 0.95rem;">Select a customer to open their billing hub and record a payment.</p>
        </div>
    </div>
    
    <div style="position: relative; max-width: 600px; margin-top: 24px; margin-bottom: 300px;">
        <label style="display: block; margin-bottom: 8px; font-weight: 600; color: var(--text-primary);">Search & Select Customer</label>
        
        <div class="form-control" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: var(--bg-secondary); padding: 14px 20px; font-size: 1rem; border: 1px solid var(--border-glass); border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);" @onclick="ToggleDropdown">
            <div style="display: flex; align-items: center; gap: 12px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <span style="color: var(--text-secondary);">Click to search for a customer...</span>
            </div>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(@(isCustomerDropdownOpen ? "180deg" : "0deg")); transition: transform 0.3s ease;"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        @if (isCustomerDropdownOpen)
        {
            <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 40;" @onclick="() => isCustomerDropdownOpen = false"></div>
            <div style="position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: var(--bg-secondary); border: 1px solid var(--border-glass); border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); z-index: 50; overflow: hidden; display: flex; flex-direction: column; max-height: 350px;">
                <div style="padding: 12px; border-bottom: 1px solid var(--border-glass); background: #f8fafc;">
                    <input type="text" @bind="customerSearchText" @bind:event="oninput" class="form-control" placeholder="Search by Name or Connection ID..." autofocus style="padding: 10px 16px; font-size: 0.95rem; border-radius: 8px; border: 1px solid #e2e8f0; width: 100%; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" />
                </div>
                <div style="overflow-y: auto;">
                    @if (filteredCustomers != null && filteredCustomers.Any())
                    {
                        @foreach (var c in filteredCustomers)
                        {
                            <div class="customer-dropdown-item" style="padding: 12px 16px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background-color 0.2s;" @onclick="() => SelectCustomer(c)">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">@c.Name</div>
                                        <div style="font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
                                            <span style="background: #f1f5f9; padding: 2px 8px; border-radius: 12px; font-weight: 600;">@c.ConnectionId</span>
                                            @if (!string.IsNullOrEmpty(c.Phone))
                                            {
                                                <span>• @c.Phone</span>
                                            }
                                        </div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Balance</div>
                                        <div style="font-size: 1.05rem; font-weight: 700; color: @(c.CurrentBalance > 0 ? "var(--accent-danger)" : "var(--accent-success)");">
                                            Rs. @c.CurrentBalance.ToString("N0")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 24px; text-align: center; color: var(--text-secondary);">
                            No customers found matching "@customerSearchText".
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .customer-dropdown-item:hover {
        background-color: #f8fafc !important;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ConnectionId { get; set; }

    private string customerSearchText = string.Empty;
    private bool isCustomerDropdownOpen = false;
    private List<Customer>? allCustomers;
    
    private IEnumerable<Customer>? filteredCustomers => 
        string.IsNullOrWhiteSpace(customerSearchText) 
            ? allCustomers 
            : allCustomers?.Where(c => 
                c.Name.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase) || 
                c.ConnectionId.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        allCustomers = await DbContext.Customers
            .Include(c => c.CurrentPackage)
            .Where(c => !c.IsDeleted && c.IsActive)
            .OrderBy(c => c.Name)
            .ToListAsync();
            
        if (!string.IsNullOrEmpty(ConnectionId) && allCustomers != null)
        {
            var foundCustomer = allCustomers.FirstOrDefault(c => c.ConnectionId == ConnectionId);
            if (foundCustomer != null)
            {
                SelectCustomer(foundCustomer);
            }
        }
    }
    
    private void ToggleDropdown()
    {
        isCustomerDropdownOpen = !isCustomerDropdownOpen;
        if (isCustomerDropdownOpen) customerSearchText = "";
    }
    
    private void SelectCustomer(Customer c)
    {
        NavManager.NavigateTo($"/customer/billing/{c.Id}");
    }
}
