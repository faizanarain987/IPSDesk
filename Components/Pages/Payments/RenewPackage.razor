@page "/payments/renew"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject IPSDesk.Services.ToastService ToastService

<PageTitle>Renew Package - Diamond ISP</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; position: relative; z-index: 10;">
    <h1>Renew Package</h1>
    <p style="color: var(--text-secondary); margin-bottom: 16px;">Bill a customer for a new month and optionally upgrade their package.</p>
    
    <div style="position: relative; max-width: 500px; margin-top: 16px;">
        <label style="display: block; margin-bottom: 8px; font-weight: 500;">Select Customer</label>
        
        <div class="form-control" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: white;" @onclick="ToggleDropdown">
            @if (customer != null)
            {
                <span style="font-weight: 500;">@customer.ConnectionId - @customer.Name</span>
            }
            else
            {
                <span style="color: var(--text-secondary);">-- Click to select a customer --</span>
            }
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(@(isCustomerDropdownOpen ? "180deg" : "0deg")); transition: transform 0.2s;"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        @if (isCustomerDropdownOpen)
        {
            <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 40;" @onclick="() => isCustomerDropdownOpen = false"></div>
            <div style="position: absolute; top: 100%; left: 0; right: 0; margin-top: 4px; background: white; border: 1px solid var(--border-glass); border-radius: 8px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); z-index: 50; overflow: hidden; display: flex; flex-direction: column; max-height: 300px;">
                <div style="padding: 8px; border-bottom: 1px solid var(--border-glass);">
                    <input type="text" @bind="customerSearchText" @bind:event="oninput" class="form-control" placeholder="Search by name or ID..." autofocus style="padding: 6px 12px; font-size: 0.9rem; border-radius: 6px;" />
                </div>
                <div style="overflow-y: auto;">
                    @if (filteredCustomers != null && filteredCustomers.Any())
                    {
                        @foreach (var c in filteredCustomers)
                        {
                            <div @onmousedown="() => SelectCustomer(c)" style="padding: 10px 16px; cursor: pointer; border-bottom: 1px solid var(--border-glass); background-color: @(customer?.Id == c.Id ? "rgba(99,102,241,0.05)" : "transparent");" onmouseover="this.style.backgroundColor='rgba(99,102,241,0.05)'" onmouseout="this.style.backgroundColor='@(customer?.Id == c.Id ? "rgba(99,102,241,0.05)" : "transparent")'">
                                <span style="font-weight: 500;">@c.ConnectionId - @c.Name</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 16px; text-align: center; color: var(--text-secondary);">No customers found.</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (customer != null)
{
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <div class="glass-panel" style="animation: fadeIn 0.3s;">
            <h2>Customer Details</h2>
            <div style="margin-bottom: 12px;"><span style="color: var(--text-secondary);">Name:</span> <strong style="color: var(--text-primary);">@customer.Name</strong></div>
            <div style="margin-bottom: 12px;"><span style="color: var(--text-secondary);">Current Package:</span> <strong style="color: var(--accent-primary);">@(customer.CurrentPackage?.Name ?? "None")</strong></div>
            <div style="margin-bottom: 12px;"><span style="color: var(--text-secondary);">Current Balance (Outstanding):</span> <strong style="color: var(--accent-danger);">Rs. @customer.CurrentBalance.ToString("N0")</strong></div>
        </div>

        <div class="glass-panel" style="animation: fadeIn 0.3s;">
            <h2>Renewal Details</h2>
            <EditForm Model="@customer" OnValidSubmit="ProcessRenewal">
                
                <div style="margin-bottom: 16px;">
                    <label>Select Package</label>
                    <InputSelect @bind-Value="selectedPackageId" class="form-control">
                        @if (allPackages != null)
                        {
                            @foreach (var pkg in allPackages)
                            {
                                <option value="@pkg.Id">@pkg.Name (Rs. @pkg.MonthlyPrice.ToString("N0"))</option>
                            }
                        }
                    </InputSelect>
                    @if (selectedPackageId != customer.CurrentPackageId)
                    {
                        <div style="margin-top: 8px; font-size: 0.85rem; color: var(--accent-danger); font-weight: 500; display: flex; align-items: center; gap: 4px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                            This will change the customer's permanent package profile.
                        </div>
                    }
                </div>
                
                <div style="margin-bottom: 16px;">
                    <label>Billing Month</label>
                    <div style="display: flex; gap: 8px;">
                        <InputSelect @bind-Value="selectedMonth" class="form-control" style="flex: 2;">
                            @foreach (var month in months)
                            {
                                <option value="@month">@month</option>
                            }
                        </InputSelect>
                        <InputSelect @bind-Value="selectedYear" class="form-control" style="flex: 1;">
                            @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 2; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                
                <button type="submit" class="btn-primary" style="width: 100%;">Charge & Renew Package</button>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? ConnectionId { get; set; }

    private string customerSearchText = string.Empty;
    private bool isCustomerDropdownOpen = false;
    private Customer? customer;
    
    private List<Customer>? allCustomers;
    private List<Package>? allPackages;
    
    private Guid? selectedPackageId;
    
    private string selectedMonth = DateTime.Now.ToString("MMMM");
    private int selectedYear = DateTime.Now.Year;
    
    private readonly string[] months = new[] 
    { 
        "January", "February", "March", "April", "May", "June", 
        "July", "August", "September", "October", "November", "December" 
    };
    
    private IEnumerable<Customer>? filteredCustomers => 
        string.IsNullOrWhiteSpace(customerSearchText) 
            ? allCustomers 
            : allCustomers?.Where(c => c.Name.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase) || c.ConnectionId.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        allPackages = await DbContext.Packages.Where(p => p.IsActive).OrderBy(p => p.MonthlyPrice).ToListAsync();
        
        allCustomers = await DbContext.Customers
            .Include(c => c.CurrentPackage)
            .Where(c => !c.IsDeleted && c.IsActive)
            .OrderBy(c => c.Name)
            .ToListAsync();
            
        if (!string.IsNullOrEmpty(ConnectionId) && allCustomers != null)
        {
            var foundCustomer = allCustomers.FirstOrDefault(c => c.ConnectionId == ConnectionId);
            if (foundCustomer != null)
            {
                SelectCustomer(foundCustomer);
            }
        }
    }
    
    private void ToggleDropdown()
    {
        isCustomerDropdownOpen = !isCustomerDropdownOpen;
        if (isCustomerDropdownOpen) customerSearchText = "";
    }
    

    
    private void SelectCustomer(Customer c)
    {
        customer = c;
        selectedPackageId = c.CurrentPackageId;
        isCustomerDropdownOpen = false;
    }

    private async Task ProcessRenewal()
    {
        if (customer == null || selectedPackageId == null || selectedPackageId == Guid.Empty) return;

        var packageToCharge = allPackages?.FirstOrDefault(p => p.Id == selectedPackageId);
        if (packageToCharge == null) return;
        
        decimal expectedFee = packageToCharge.MonthlyPrice;
        string billingMonthString = $"{selectedMonth} {selectedYear}";

        // Increase Debt
        customer.CurrentBalance += expectedFee;
        
        var feeLedger = new CustomerLedger
        {
            Id = Guid.NewGuid(),
            CustomerId = customer.Id,
            TransactionDate = DateTime.Now,
            Description = $"Monthly Package Charge ({packageToCharge.Name}) - {billingMonthString}",
            Debit = expectedFee,
            Credit = 0,
            Balance = customer.CurrentBalance
        };
        DbContext.CustomerLedgers.Add(feeLedger);
        
        var history = new MonthlyPackageHistory
        {
            CustomerId = customer.Id,
            PackageId = packageToCharge.Id,
            BillingMonth = billingMonthString,
            PackagePrice = expectedFee,
            AmountPaid = 0,
            RemainingBalance = customer.CurrentBalance,
            PaymentStatus = "Unpaid",
            RenewalDate = DateTime.Now
        };
        DbContext.MonthlyPackageHistories.Add(history);
        
        // Update Customer Profile if package changed
        if (customer.CurrentPackageId != selectedPackageId)
        {
            customer.CurrentPackageId = selectedPackageId;
        }
        
        DbContext.Customers.Update(customer);
        await DbContext.SaveChangesAsync();
        
        ToastService.ShowSuccess("Customer renewed successfully.");
        NavManager.NavigateTo($"/customers/profile/{customer.Id}");
    }
}
