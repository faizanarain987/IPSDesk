@page "/payments/renew"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject IPSDesk.Services.ToastService ToastService

<PageTitle>Renew Package - Diamond ISP</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; position: relative; z-index: 10; border-top: 4px solid var(--accent-primary); background: linear-gradient(145deg, #ffffff, #f8fafc);">
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 8px;">
        <div style="background: rgba(59, 130, 246, 0.1); color: var(--accent-primary); padding: 12px; border-radius: 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.59-9.21l5.94 4.5"/></svg>
        </div>
        <div>
            <h1 style="margin: 0; font-weight: 700;">Renew Package</h1>
            <p style="color: var(--text-secondary); margin: 4px 0 0 0; font-size: 0.95rem;">Bill a customer for a new month and optionally upgrade their package.</p>
        </div>
    </div>
    
    <div style="position: relative; max-width: 600px; margin-top: 24px;">
        <label style="display: block; margin-bottom: 8px; font-weight: 600; color: var(--text-primary);">Search & Select Customer</label>
        
        <div class="form-control" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: white; padding: 14px 20px; font-size: 1rem; border: 1px solid var(--border-glass); border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);" @onclick="ToggleDropdown">
            <div style="display: flex; align-items: center; gap: 12px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                @if (customer != null)
                {
                    <span style="font-weight: 600; color: var(--text-primary);">@customer.ConnectionId - @customer.Name</span>
                }
                else
                {
                    <span style="color: var(--text-secondary);">Click to search for a customer...</span>
                }
            </div>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(@(isCustomerDropdownOpen ? "180deg" : "0deg")); transition: transform 0.3s ease;"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        @if (isCustomerDropdownOpen)
        {
            <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 40;" @onclick="() => isCustomerDropdownOpen = false"></div>
            <div style="position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: white; border: 1px solid var(--border-glass); border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); z-index: 50; overflow: hidden; display: flex; flex-direction: column; max-height: 350px;">
                <div style="padding: 12px; border-bottom: 1px solid var(--border-glass); background: #f8fafc;">
                    <input type="text" @bind="customerSearchText" @bind:event="oninput" class="form-control" placeholder="Search by Name or Connection ID..." autofocus style="padding: 10px 16px; font-size: 0.95rem; border-radius: 8px; border: 1px solid #e2e8f0; width: 100%; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" />
                </div>
                <div style="overflow-y: auto;">
                    @if (filteredCustomers != null && filteredCustomers.Any())
                    {
                        @foreach (var c in filteredCustomers)
                        {
                            <div @onmousedown="() => SelectCustomer(c)" style="padding: 14px 20px; cursor: pointer; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; transition: background-color 0.2s;" class="customer-dropdown-item">
                                <div>
                                    <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 4px;">@c.Name</div>
                                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Conn ID: @c.ConnectionId</div>
                                </div>
                                @if (c.CurrentPackage != null)
                                {
                                    <div style="background: rgba(59, 130, 246, 0.1); color: var(--accent-primary); padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">
                                        @c.CurrentPackage.Name
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 24px; text-align: center; color: var(--text-secondary); display: flex; flex-direction: column; align-items: center; gap: 8px;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <span>No customers found matching "@customerSearchText"</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (customer != null)
{
    <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 32px; animation: slideUpFade 0.4s ease-out forwards;">
        <!-- Customer Details Card -->
        <div class="glass-panel" style="padding: 0; overflow: hidden;">
            <div style="padding: 24px; background: #f8fafc; border-bottom: 1px solid var(--border-glass);">
                <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Customer Profile
                </h2>
            </div>
            
            <div style="padding: 24px;">
                <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px;">
                    <div style="background: rgba(99, 102, 241, 0.1); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #6366f1; font-weight: 700; font-size: 1.2rem;">
                        @(customer.Name.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <div style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">@customer.Name</div>
                        <div style="color: var(--text-secondary); font-size: 0.9rem;">Connection ID: @customer.ConnectionId</div>
                    </div>
                </div>
                
                <div style="background: #f1f5f9; padding: 16px; border-radius: 12px; margin-bottom: 20px;">
                    <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; font-weight: 600; margin-bottom: 4px;">Current Package</div>
                    <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-primary); display: flex; align-items: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        @(customer.CurrentPackage?.Name ?? "None")
                    </div>
                </div>

                <div style="background: #fff1f2; border: 1px solid #ffe4e6; padding: 16px; border-radius: 12px;">
                    <div style="color: #e11d48; font-size: 0.85rem; text-transform: uppercase; font-weight: 600; margin-bottom: 4px;">Current Balance (Outstanding)</div>
                    <div style="font-size: 1.4rem; font-weight: 800; color: #be123c;">
                        Rs. @customer.CurrentBalance.ToString("N0")
                    </div>
                </div>
            </div>
        </div>

        <!-- Renewal Action Card -->
        <div class="glass-panel" style="padding: 0; overflow: hidden; border-top: 4px solid var(--accent-success);">
            <div style="padding: 24px; border-bottom: 1px solid var(--border-glass);">
                <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    Process Renewal
                </h2>
            </div>

            <div style="padding: 24px;">
                <EditForm Model="@customer" OnValidSubmit="ProcessRenewal">
                    
                    <div style="margin-bottom: 24px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px;">Select Package to Renew</label>
                        <InputSelect @bind-Value="selectedPackageId" class="form-control" style="padding: 12px; font-size: 1rem; border-radius: 8px;">
                            @if (allPackages != null)
                            {
                                @foreach (var pkg in allPackages)
                                {
                                    <option value="@pkg.Id">@pkg.Name — Rs. @pkg.MonthlyPrice.ToString("N0") / month</option>
                                }
                            }
                        </InputSelect>
                        @if (selectedPackageId != customer.CurrentPackageId)
                        {
                            <div style="margin-top: 12px; padding: 12px; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 8px; font-size: 0.85rem; color: #b45309; font-weight: 500; display: flex; align-items: flex-start; gap: 8px;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                <span><strong>Note:</strong> You have selected a different package. This will permanently update the customer's package profile.</span>
                            </div>
                        }
                    </div>
                    
                    <div style="margin-bottom: 32px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px;">Billing Period</label>
                        <div style="display: flex; gap: 12px;">
                            <InputSelect @bind-Value="selectedMonth" class="form-control" style="flex: 2; padding: 12px; font-size: 1rem; border-radius: 8px;">
                                @foreach (var month in months)
                                {
                                    <option value="@month">@month</option>
                                }
                            </InputSelect>
                            <InputSelect @bind-Value="selectedYear" class="form-control" style="flex: 1; padding: 12px; font-size: 1rem; border-radius: 8px;">
                                @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 2; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-primary" style="width: 100%; padding: 16px; font-size: 1.1rem; font-weight: 700; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.39);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Charge & Renew Package
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .customer-dropdown-item:hover {
        background-color: #f8fafc !important;
    }
    
    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ConnectionId { get; set; }

    private string customerSearchText = string.Empty;
    private bool isCustomerDropdownOpen = false;
    private Customer? customer;
    
    private List<Customer>? allCustomers;
    private List<Package>? allPackages;
    
    private Guid? selectedPackageId;
    
    private string selectedMonth = DateTime.Now.ToString("MMMM");
    private int selectedYear = DateTime.Now.Year;
    
    private readonly string[] months = new[] 
    { 
        "January", "February", "March", "April", "May", "June", 
        "July", "August", "September", "October", "November", "December" 
    };
    
    private IEnumerable<Customer>? filteredCustomers => 
        string.IsNullOrWhiteSpace(customerSearchText) 
            ? allCustomers 
            : allCustomers?.Where(c => c.Name.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase) || c.ConnectionId.Contains(customerSearchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        allPackages = await DbContext.Packages.Where(p => p.IsActive).OrderBy(p => p.MonthlyPrice).ToListAsync();
        
        allCustomers = await DbContext.Customers
            .Include(c => c.CurrentPackage)
            .Where(c => !c.IsDeleted && c.IsActive)
            .OrderBy(c => c.Name)
            .ToListAsync();
            
        if (!string.IsNullOrEmpty(ConnectionId) && allCustomers != null)
        {
            var foundCustomer = allCustomers.FirstOrDefault(c => c.ConnectionId == ConnectionId);
            if (foundCustomer != null)
            {
                SelectCustomer(foundCustomer);
            }
        }
    }
    
    private void ToggleDropdown()
    {
        isCustomerDropdownOpen = !isCustomerDropdownOpen;
        if (isCustomerDropdownOpen) customerSearchText = "";
    }
    

    
    private void SelectCustomer(Customer c)
    {
        customer = c;
        selectedPackageId = c.CurrentPackageId;
        isCustomerDropdownOpen = false;
    }

    private async Task ProcessRenewal()
    {
        if (customer == null || selectedPackageId == null || selectedPackageId == Guid.Empty) return;

        var packageToCharge = allPackages?.FirstOrDefault(p => p.Id == selectedPackageId);
        if (packageToCharge == null) return;
        
        decimal expectedFee = packageToCharge.MonthlyPrice;
        string billingMonthString = $"{selectedMonth} {selectedYear}";

        // Increase Debt
        customer.CurrentBalance += expectedFee;
        
        var feeLedger = new CustomerLedger
        {
            Id = Guid.NewGuid(),
            CustomerId = customer.Id,
            TransactionDate = DateTime.Now,
            Description = $"Monthly Package Charge ({packageToCharge.Name}) - {billingMonthString}",
            Debit = expectedFee,
            Credit = 0,
            Balance = customer.CurrentBalance
        };
        DbContext.CustomerLedgers.Add(feeLedger);
        
        var history = new MonthlyPackageHistory
        {
            CustomerId = customer.Id,
            PackageId = packageToCharge.Id,
            BillingMonth = billingMonthString,
            PackagePrice = expectedFee,
            AmountPaid = 0,
            RemainingBalance = customer.CurrentBalance,
            PaymentStatus = "Unpaid",
            RenewalDate = DateTime.Now
        };
        DbContext.MonthlyPackageHistories.Add(history);
        
        // Update Customer Profile if package changed
        if (customer.CurrentPackageId != selectedPackageId)
        {
            customer.CurrentPackageId = selectedPackageId;
        }
        
        DbContext.Customers.Update(customer);
        await DbContext.SaveChangesAsync();
        
        ToastService.ShowSuccess("Customer renewed successfully.");
        NavManager.NavigateTo($"/customers/profile/{customer.Id}");
    }
}
