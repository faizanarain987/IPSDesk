@page "/payments/receipt/{Id:guid}"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

@inject IJSRuntime JSRuntime

<PageTitle>Payment Receipt - Diamond Net</PageTitle>

@if (payment == null)
{
    <div style="padding: 40px; text-align: center; color: var(--text-secondary);">
        <div class="spinner" style="margin: 0 auto 16px auto; width: 40px; height: 40px; border: 3px solid rgba(0,0,0,0.1); border-radius: 50%; border-top-color: var(--accent-primary); animation: spin 1s linear infinite;"></div>
        <p>Loading receipt...</p>
    </div>
}
else
{
    <div style="max-width: 800px; margin: 0 auto; animation: slideUpFade 0.4s ease-out forwards;">
        <!-- Action Buttons (Hidden when printing) -->
        <div class="no-print" style="margin-bottom: 24px; display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn-secondary" @onclick='() => NavManager.NavigateTo("/payments")' style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Back
            </button>
            <button class="btn-secondary" onclick="window.print()" style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                Print
            </button>
            <button class="btn-primary" @onclick="DownloadPdf" style="display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.39);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Download PDF
            </button>
        </div>

        <!-- The Receipt Content -->
        <div id="receipt-content" style="background: var(--bg-secondary); padding: 40px; font-family: 'Inter', Arial, sans-serif; color: var(--text-primary); line-height: 1.5; box-shadow: 0 10px 40px -10px rgba(0,0,0,0.1);">
            
            @{
                var currentPkg = packageHistory.FirstOrDefault();
                var prevPkg = packageHistory.Skip(1).FirstOrDefault();
            }

            <!-- HEADER -->
            <div style="text-align: center; margin-bottom: 20px; border-bottom: 1px dashed #ccc; padding-bottom: 20px;">
                <h1 style="margin: 0; font-size: 24px; font-weight: bold; color: #1e293b;">@(companySettings?.CompanyName ?? "Diamond Net")</h1>
                @if (companySettings != null)
                {
                    <div style="color: #475569; font-size: 13px; margin-top: 6px; display: flex; flex-direction: column; gap: 4px; align-items: center;">
                        @if (!string.IsNullOrEmpty(companySettings.Address))
                        {
                            <div>Office Address: @companySettings.Address</div>
                        }
                        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                            @if (!string.IsNullOrEmpty(companySettings.Phone))
                            {
                                <span>Phone: @companySettings.Phone</span>
                            }
                            @if (!string.IsNullOrEmpty(companySettings.WhatsApp))
                            {
                                <span>WhatsApp: @companySettings.WhatsApp</span>
                            }
                            @if (!string.IsNullOrEmpty(companySettings.Email))
                            {
                                <span>Email: @companySettings.Email</span>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <!-- BILL TO & INVOICE INFO -->
            <div style="display: flex; justify-content: space-between; margin-bottom: 20px; border-bottom: 1px dashed #ccc; padding-bottom: 20px;">
                <div>
                    <div style="font-weight: bold; font-size: 16px; margin-bottom: 8px; color: #0f172a;">Bill To</div>
                    <div style="font-size: 14px; color: #334155;">@(payment.Customer?.Name ?? "Unknown")</div>
                    <div style="font-size: 14px; color: #334155;">Customer ID: <strong>@(payment.Customer?.ConnectionId ?? "N/A")</strong></div>
                    <div style="font-size: 14px; color: #334155;">@(payment.Customer?.Phone ?? "N/A")</div>
                    <div style="font-size: 14px; color: #334155;">@(payment.Customer?.Area ?? "N/A")</div>
                </div>
                <div style="text-align: right;">
                    <div style="font-weight: bold; font-size: 16px; margin-bottom: 8px; color: #0f172a;">Invoice</div>
                    <div style="font-size: 14px; color: #334155;">Invoice No: <strong>@payment.ReceiptNumber</strong></div>
                    <div style="font-size: 14px; color: #334155;">Invoice Date: <strong>@payment.PaymentDate.ToString("dd-MMM-yyyy")</strong></div>
                </div>
            </div>
            
            <!-- CURRENT PACKAGE -->
            <div style="margin-bottom: 20px; border-bottom: 1px dashed #ccc; padding-bottom: 20px;">
                <div style="font-weight: bold; font-size: 16px; margin-bottom: 12px; color: #0f172a;">Current Package</div>
                @if (currentPkg != null && currentPkg.Package != null)
                {
                    <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 14px;">
                        <div style="color: #64748b;">Package</div>
                        <div style="font-weight: bold; color: #334155;">@currentPkg.Package.Name</div>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 14px;">
                        <div style="color: #64748b;">Billing Period</div>
                        <div style="font-weight: bold; color: #334155;">@currentPkg.RenewalDate.ToString("dd-MMM-yyyy") to @currentPkg.RenewalDate.AddMonths(1).ToString("dd-MMM-yyyy")</div>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 14px;">
                        <div style="color: #64748b;">Package Amount</div>
                        <div style="font-weight: bold; color: #334155;">Rs. @currentPkg.PackagePrice.ToString("N0")</div>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 14px;">
                        <div style="color: #64748b;">Status</div>
                        <div style="font-weight: bold; color: #334155;">Active</div>
                    </div>
                }
                else
                {
                    <div style="font-size: 14px; color: #64748b;">No current package on record.</div>
                }
            </div>
            
            <!-- RECEIPT BREAKDOWN -->
            <div style="margin-bottom: 20px;">
                @{
                    decimal S = (payment.Customer?.CurrentBalance ?? 0) + payment.AmountCollected;
                    decimal prevBalance = 0;
                    
                    decimal X1 = S - payment.TotalCharge + payment.Discount + payment.PackageCharges;
                    if (payment.PackageCharges > 0 && X1 >= payment.PackageCharges)
                    {
                        prevBalance = X1;
                    }
                    else
                    {
                        prevBalance = S - payment.TotalCharge + payment.Discount;
                    }
                    
                    decimal displayPrevBalance = prevBalance;
                    
                    if (payment.PackageCharges > 0)
                    {
                        if (prevBalance == payment.PackageCharges)
                        {
                            displayPrevBalance = 0;
                        }
                        else if (prevBalance > payment.PackageCharges)
                        {
                            displayPrevBalance = prevBalance - payment.PackageCharges;
                        }
                    }
                    
                    decimal totalAmountDue = displayPrevBalance + payment.TotalCharge - payment.Discount;
                }
                <div style="font-weight: bold; font-size: 16px; margin-bottom: 12px; color: #0f172a; border-bottom: 1px dashed #ccc; padding-bottom: 8px;">Receipt Breakdown</div>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <div style="color: #64748b;">Previous Balance</div>
                    <div style="font-weight: 500; color: #334155;">Rs. @displayPrevBalance.ToString("N0")</div>
                </div>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <div style="color: #64748b;">Package Charges</div>
                    <div style="font-weight: bold; color: #334155;">Rs. @payment.PackageCharges.ToString("N0")</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <div style="color: #64748b;">Connection Charges</div>
                    <div style="font-weight: bold; color: #334155;">Rs. @payment.ConnectionCharges.ToString("N0")</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <div style="color: #64748b;">Router Charges</div>
                    <div style="font-weight: bold; color: #334155;">Rs. @payment.RouterCharges.ToString("N0")</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <div style="color: #64748b;">Fibre Charges</div>
                    <div style="font-weight: bold; color: #334155;">Rs. @payment.FibreCharges.ToString("N0")</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <div style="color: #64748b;">Complain Charges</div>
                    <div style="font-weight: bold; color: #334155;">Rs. @payment.ComplainCharges.ToString("N0")</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                    <div style="color: #64748b;">Other Charges</div>
                    <div style="font-weight: bold; color: #334155;">Rs. @payment.OtherCharges.ToString("N0")</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; border-bottom: 1px dashed #ccc; padding-bottom: 8px;">
                    <div style="color: #64748b;">Total Charges</div>
                    <div style="font-weight: bold; color: #334155;">Rs. @payment.TotalCharge.ToString("N0")</div>
                </div>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; padding-top: 8px;">
                    <div style="color: #64748b;">Discount Applied</div>
                    <div style="font-weight: bold; color: #ef4444;">- Rs. @payment.Discount.ToString("N0")</div>
                </div>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; padding-top: 8px;">
                    <div style="color: #0f172a; font-weight: bold;">Amount To Be Pay After Discount</div>
                    <div style="font-weight: bold; color: #0f172a;">Rs. @totalAmountDue.ToString("N0")</div>
                </div>
                
                <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 14px;">
                    <div style="color: #64748b;">Amount Collected</div>
                    <div style="font-weight: bold; color: #0f172a;">Rs. @payment.AmountCollected.ToString("N0")</div>
                </div>
                
                <div style="border: 2px solid #334155; padding: 16px; text-align: center; margin-top: 24px; border-radius: 4px;">
                    <div style="color: #0f172a; font-size: 14px; margin-bottom: 8px; font-weight: 500;">Customer Balance</div>
                    <div style="color: #dc2626; font-size: 24px; font-weight: 800;">Rs. @(payment.Customer?.CurrentBalance.ToString("N0") ?? "0")</div>
                </div>
            </div>
            
            <div style="text-align: center; color: #94a3b8; font-size: 12px; margin-top: 20px;">
                Generated @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
            </div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @@media print {
        body * {
            visibility: hidden;
        }
        #receipt-content, #receipt-content * {
            visibility: visible;
        }
        #receipt-content {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none !important;
            padding: 0 !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Payment? payment;
    private List<MonthlyPackageHistory> packageHistory = new();
    private CompanySettings? companySettings;

    protected override async Task OnInitializedAsync()
    {
        companySettings = await DbContext.CompanySettings.FirstOrDefaultAsync();
        
        payment = await DbContext.Payments
            .Include(p => p.Customer)
                .ThenInclude(c => c.CurrentPackage)
            .Include(p => p.PaymentMethod)
            .FirstOrDefaultAsync(p => p.Id == Id);
            
        if (payment == null)
        {
            NavManager.NavigateTo("/payments/new");
            return;
        }
        
        packageHistory = await DbContext.MonthlyPackageHistories
            .Include(h => h.Package)
            .Where(h => h.CustomerId == payment.CustomerId && h.RenewalDate <= payment.PaymentDate)
            .OrderByDescending(h => h.RenewalDate)
            .Take(2)
            .ToListAsync();
    }
    
    private async Task DownloadPdf()
    {
        var filename = $"Receipt_{payment?.ReceiptNumber}.pdf";
        await JSRuntime.InvokeVoidAsync("downloadReceiptPdf", "receipt-content", filename);
    }
}

