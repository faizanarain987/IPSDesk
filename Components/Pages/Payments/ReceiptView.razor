@page "/payments/receipt/{Id:guid}"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

<PageTitle>Payment Receipt - Diamond ISP</PageTitle>

@if (payment == null)
{
    <p>Loading...</p>
}
else
{
    <div style="max-width: 600px; margin: 0 auto;">
        <div class="glass-panel" style="background-color: var(--bg-main); border: 2px solid var(--border-glass);">
            <div style="text-align: center; margin-bottom: 24px; border-bottom: 1px dashed var(--text-secondary); padding-bottom: 16px;">
                <h1 style="color: var(--accent-primary); margin-bottom: 8px;">Diamond ISP</h1>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">Payment Receipt</p>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px;">
                <div><span style="color: var(--text-secondary);">Receipt No:</span> <strong>@payment.ReceiptNumber</strong></div>
                <div style="text-align: right;"><span style="color: var(--text-secondary);">Date:</span> @payment.PaymentDate.ToString("MMM dd, yyyy HH:mm")</div>
                
                <div><span style="color: var(--text-secondary);">Customer:</span> <strong>@(payment.Customer?.Name ?? "Unknown")</strong></div>
                <div style="text-align: right;"><span style="color: var(--text-secondary);">Conn ID:</span> @(payment.Customer?.ConnectionId ?? "N/A")</div>
            </div>
            
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                <tr style="border-bottom: 1px solid var(--border-glass);">
                    <th style="text-align: left; padding: 8px 0; color: var(--text-secondary);">Description</th>
                    <th style="text-align: right; padding: 8px 0; color: var(--text-secondary);">Amount</th>
                </tr>
                <tr>
                    <td style="padding: 12px 0;">
                        <div>@payment.PaymentType</div>
                        <div style="font-size: 0.85rem; color: var(--text-secondary);">Billing Month: @payment.BillingMonth</div>
                        <div style="font-size: 0.85rem; color: var(--text-secondary);">Package: @(payment.Customer?.CurrentPackage?.Name ?? "N/A")</div>
                    </td>
                    <td style="text-align: right; font-weight: 600;">Rs. @payment.AmountCollected.ToString("N0")</td>
                </tr>
            </table>
            
            <div style="display: flex; justify-content: space-between; border-top: 1px dashed var(--text-secondary); padding-top: 16px;">
                <div>
                    <div style="color: var(--text-secondary); font-size: 0.85rem;">Payment Method</div>
                    <div>@(payment.PaymentMethod?.Name ?? "Unknown")</div>
                </div>
                <div style="text-align: right;">
                    <div style="color: var(--text-secondary); font-size: 0.85rem;">Remaining Balance</div>
                    <div style="color: @(payment.Customer?.CurrentBalance > 0 ? "var(--accent-danger)" : "var(--accent-success)"); font-weight: 600;">
                        Rs. @(payment.Customer?.CurrentBalance.ToString("N0") ?? "0")
                    </div>
                </div>
            </div>
            
            <div style="text-align: center; margin-top: 32px; font-size: 0.85rem; color: var(--text-secondary);">
                Thank you for your business!
            </div>
        </div>
        
        <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: center;">
            <button class="btn-primary" onclick="window.print()">Print Receipt</button>
            <button class="btn-secondary" @onclick='() => NavManager.NavigateTo("/payments/new")'>Back to Payments</button>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Payment? payment;

    protected override async Task OnInitializedAsync()
    {
        payment = await DbContext.Payments
            .Include(p => p.Customer)
                .ThenInclude(c => c.CurrentPackage)
            .Include(p => p.PaymentMethod)
            .FirstOrDefaultAsync(p => p.Id == Id);
            
        if (payment == null)
        {
            NavManager.NavigateTo("/payments/new");
        }
    }
}
