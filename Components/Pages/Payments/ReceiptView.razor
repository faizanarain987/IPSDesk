@page "/payments/receipt/{Id:guid}"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

@inject IJSRuntime JSRuntime

<PageTitle>Payment Receipt - Diamond ISP</PageTitle>

@if (payment == null)
{
    <div style="padding: 40px; text-align: center; color: var(--text-secondary);">
        <div class="spinner" style="margin: 0 auto 16px auto; width: 40px; height: 40px; border: 3px solid rgba(0,0,0,0.1); border-radius: 50%; border-top-color: var(--accent-primary); animation: spin 1s linear infinite;"></div>
        <p>Loading receipt...</p>
    </div>
}
else
{
    <div style="max-width: 700px; margin: 0 auto; animation: slideUpFade 0.4s ease-out forwards;">
        <!-- Action Buttons (Hidden when printing) -->
        <div class="no-print" style="margin-bottom: 24px; display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn-secondary" @onclick='() => NavManager.NavigateTo("/payments")' style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Back
            </button>
            <button class="btn-secondary" onclick="window.print()" style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                Print
            </button>
            <button class="btn-primary" @onclick="DownloadPdf" style="display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.39);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Download PDF
            </button>
        </div>

        <!-- The Receipt Content -->
        <div id="receipt-content" style="background: white; border-radius: 12px; box-shadow: 0 10px 40px -10px rgba(0,0,0,0.1); overflow: hidden; position: relative;">
            
            <!-- Colored Top Bar -->
            <div style="height: 8px; background: linear-gradient(90deg, var(--accent-primary), #818cf8);"></div>
            
            <div style="padding: 48px;">
                <!-- Header Section -->
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <div style="background: linear-gradient(135deg, var(--accent-primary), #6366f1); color: white; padding: 10px; border-radius: 10px;">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                            </div>
                            <div>
                                <h1 style="margin: 0; font-size: 1.8rem; font-weight: 800; color: #1e293b; letter-spacing: -0.02em;">Diamond ISP</h1>
                                <div style="color: var(--text-secondary); font-size: 0.95rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em;">Official Receipt</div>
                            </div>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 2.2rem; font-weight: 800; color: var(--accent-success); line-height: 1;">Rs. @payment.AmountCollected.ToString("N0")</div>
                        <div style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; font-weight: 500;">Amount Paid</div>
                    </div>
                </div>
                
                <!-- Info Grid -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 40px; padding: 24px; background: #f8fafc; border-radius: 12px; border: 1px solid #f1f5f9;">
                    <div>
                        <div style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px;">Receipt No</div>
                        <div style="font-family: monospace; font-weight: 600; font-size: 1.1rem; color: #0f172a;">@payment.ReceiptNumber</div>
                    </div>
                    <div style="text-align: right;">
                        <div style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px;">Date</div>
                        <div style="font-weight: 600; font-size: 1.1rem; color: #0f172a;">@payment.PaymentDate.ToString("MMM dd, yyyy")</div>
                        <div style="font-size: 0.85rem; color: var(--text-secondary);">@payment.PaymentDate.ToString("hh:mm tt")</div>
                    </div>
                    
                    <div>
                        <div style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px;">Billed To</div>
                        <div style="font-weight: 700; font-size: 1.1rem; color: #0f172a;">@(payment.Customer?.Name ?? "Unknown")</div>
                        <div style="font-size: 0.9rem; color: var(--text-secondary);">Conn ID: @(payment.Customer?.ConnectionId ?? "N/A")</div>
                    </div>
                    <div style="text-align: right;">
                        <div style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px;">Payment Method</div>
                        <div style="font-weight: 600; font-size: 1.1rem; color: #0f172a;">@(payment.PaymentMethod?.Name ?? "Unknown")</div>
                        <div style="font-size: 0.9rem; color: var(--text-secondary);">Processed by: @(payment.CreatedByName ?? "System")</div>
                    </div>
                </div>
                
                <!-- Line Items Table -->
                <div style="margin-bottom: 40px;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #e2e8f0;">
                                <th style="text-align: left; padding: 12px 8px; color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Description</th>
                                <th style="text-align: right; padding: 12px 8px; color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 20px 8px;">
                                    <div style="font-weight: 700; font-size: 1.1rem; color: #1e293b; margin-bottom: 4px;">@payment.PaymentType</div>
                                    @if (!string.IsNullOrEmpty(payment.BillingMonth))
                                    {
                                        <div style="font-size: 0.95rem; color: var(--text-secondary); display: flex; align-items: center; gap: 6px; margin-bottom: 2px;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                            Billing Month: <strong>@payment.BillingMonth</strong>
                                        </div>
                                    }
                                    <div style="font-size: 0.95rem; color: var(--text-secondary); display: flex; align-items: center; gap: 6px;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                        Package: @(payment.Customer?.CurrentPackage?.Name ?? "N/A")
                                    </div>
                                </td>
                                <td style="text-align: right; padding: 20px 8px; font-weight: 700; font-size: 1.1rem; color: #1e293b;">
                                    Rs. @payment.AmountCollected.ToString("N0")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Footer & Balance -->
                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 2px solid #e2e8f0; padding-top: 24px;">
                    <div style="color: var(--text-secondary); font-size: 0.9rem; display: flex; align-items: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        Thank you for your business!
                    </div>
                    
                    <div style="text-align: right;">
                        <div style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px;">Customer Remaining Balance</div>
                        <div style="font-size: 1.25rem; font-weight: 800; color: @(payment.Customer?.CurrentBalance > 0 ? "#be123c" : "var(--accent-success)")">
                            Rs. @(payment.Customer?.CurrentBalance.ToString("N0") ?? "0")
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Decorative Bottom Gradient -->
            <div style="height: 8px; background: linear-gradient(90deg, #818cf8, var(--accent-primary)); opacity: 0.1;"></div>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @@media print {
        body * {
            visibility: hidden;
        }
        #receipt-content, #receipt-content * {
            visibility: visible;
        }
        #receipt-content {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none !important;
            border-radius: 0 !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Payment? payment;

    protected override async Task OnInitializedAsync()
    {
        payment = await DbContext.Payments
            .Include(p => p.Customer)
                .ThenInclude(c => c.CurrentPackage)
            .Include(p => p.PaymentMethod)
            .FirstOrDefaultAsync(p => p.Id == Id);
            
        if (payment == null)
        {
            NavManager.NavigateTo("/payments/new");
        }
    }
    
    private async Task DownloadPdf()
    {
        var filename = $"Receipt_{payment?.ReceiptNumber}.pdf";
        await JSRuntime.InvokeVoidAsync("downloadReceiptPdf", "receipt-content", filename);
    }
}
