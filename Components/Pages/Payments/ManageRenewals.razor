@page "/renewals/history"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

<PageTitle>Renewal History - Diamond ISP</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1>Renewal History</h1>
            <p style="color: var(--text-secondary);">View and manage all customer package renewals.</p>
        </div>
        <button class="btn-primary" @onclick='() => NavManager.NavigateTo("/payments/renew")'>+ Renew Package</button>
    </div>
</div>

<div class="glass-panel">
    @if (renewals == null)
    {
        <p>Loading...</p>
    }
    else if (!renewals.Any())
    {
        <p>No renewals recorded yet.</p>
    }
    else
    {
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Date of Renew</th>
                    <th>Connection ID</th>
                    <th>Customer Name</th>
                    <th>Billing Month</th>
                    <th>Package</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Renewed By</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var history in renewals)
                {
                    <tr>
                        <td>@history.RenewalDate.ToString("MMM dd, yyyy")</td>
                        <td style="color: var(--text-secondary);">@(history.Customer?.ConnectionId ?? "N/A")</td>
                        <td style="font-weight: 500; color: #111827;">@(history.Customer?.Name ?? "Unknown")</td>
                        <td>@history.BillingMonth</td>
                        <td>@(history.Package?.Name ?? "Unknown")</td>
                        <td style="font-weight: 600;">Rs. @history.PackagePrice.ToString("N0")</td>
                        <td>
                            <span style="display: inline-block; padding: 4px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; background-color: @(history.PaymentStatus == "Paid" ? "#D1FAE5" : (history.PaymentStatus == "Partially Paid" ? "#FEF3C7" : "#FEE2E2")); color: @(history.PaymentStatus == "Paid" ? "#047857" : (history.PaymentStatus == "Partially Paid" ? "#B45309" : "#B91C1C")); border: 1px solid @(history.PaymentStatus == "Paid" ? "#34D399" : (history.PaymentStatus == "Partially Paid" ? "#FBBF24" : "#F87171"));">
                                @history.PaymentStatus
                            </span>
                        </td>
                        <td>
                            <span style="font-size: 0.85rem; color: var(--text-secondary); background: rgba(0,0,0,0.04); padding: 2px 8px; border-radius: 12px;">@(history.CreatedByName ?? "System")</span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <button class="btn-icon" style="color: var(--accent-primary);" @onclick='() => NavManager.NavigateTo($"/customers/profile/{history.CustomerId}")' title="View Customer Profile">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<MonthlyPackageHistory>? renewals;

    protected override async Task OnInitializedAsync()
    {
        renewals = await DbContext.MonthlyPackageHistories
            .Include(h => h.Customer)
            .Include(h => h.Package)
            .OrderByDescending(h => h.RenewalDate)
            .Take(100)
            .ToListAsync();
    }
}
