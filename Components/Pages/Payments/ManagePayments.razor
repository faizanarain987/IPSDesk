@page "/payments"

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager

<PageTitle>Manage Payments - Diamond ISP</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1>Payment History</h1>
            <p style="color: var(--text-secondary);">View and manage all customer payments.</p>
        </div>
        <button class="btn-primary" @onclick='() => NavManager.NavigateTo("/payments/new")'>+ Record Payment</button>
    </div>
</div>

<div class="glass-panel">
    @if (payments == null)
    {
        <p>Loading...</p>
    }
    else if (!payments.Any())
    {
        <p>No payments recorded yet.</p>
    }
    else
    {
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Receipt No</th>
                    <th>Date</th>
                    <th>Connection ID</th>
                    <th>Customer</th>
                    <th>Method</th>
                    <th>Billing Month</th>
                    <th>Amount</th>
                    <th>Processed By</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in payments)
                {
                    <tr>
                        <td style="font-family: monospace; font-weight: 500;">@payment.ReceiptNumber</td>
                        <td>@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                        <td style="color: var(--text-secondary);">@(payment.Customer?.ConnectionId ?? "N/A")</td>
                        <td style="font-weight: 500; color: #111827;">@(payment.Customer?.Name ?? "Unknown")</td>
                        <td>@(payment.PaymentMethod?.Name ?? "Unknown")</td>
                        <td>@payment.BillingMonth</td>
                        <td style="font-weight: 600; color: var(--accent-success);">Rs. @payment.AmountCollected.ToString("N0")</td>
                        <td>
                            <span style="font-size: 0.85rem; color: var(--text-secondary); background: rgba(0,0,0,0.04); padding: 2px 8px; border-radius: 12px;">@(payment.CreatedByName ?? "System")</span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <button class="btn-icon" style="color: var(--accent-primary);" @onclick='() => NavManager.NavigateTo($"/payments/receipt/{payment.Id}")' title="View Receipt">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Payment>? payments;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        payments = await DbContext.Payments
            .Include(p => p.Customer)
            .Include(p => p.PaymentMethod)
            .OrderByDescending(p => p.PaymentDate)
            .Take(100)
            .ToListAsync();
    }
}
