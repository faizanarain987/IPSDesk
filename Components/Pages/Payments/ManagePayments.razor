@page "/payments"
@attribute [Authorize(Policy = IPSDesk.Models.AppPermissions.Payments.ViewHistory)]

@using IPSDesk.Data
@using IPSDesk.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject IPSDesk.Services.ICurrentUserService CurrentUserService
@inject IPSDesk.Services.ToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Manage Payments - Diamond Net</PageTitle>

<div class="glass-panel" style="margin-bottom: 24px; position: relative; z-index: 10; border-top: 4px solid var(--accent-primary); background: linear-gradient(145deg, #ffffff, #f8fafc);">
    <div class="responsive-flex" style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="background: rgba(59, 130, 246, 0.1); color: var(--accent-primary); padding: 12px; border-radius: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <div>
                <h1 style="margin: 0; font-weight: 700;">Payment History</h1>
                <p style="color: var(--text-secondary); margin: 4px 0 0 0; font-size: 0.95rem;">View and manage all recorded customer payments.</p>
            </div>
        </div>
        <button class="btn-primary" @onclick='() => NavManager.NavigateTo("/customers/billinghub")' style="padding: 12px 20px; font-weight: 600; border-radius: 10px; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px 0 rgba(16, 185, 129, 0.39); background-color: var(--accent-success);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Record Payment
        </button>
    </div>
</div>

<div class="glass-panel" style="padding: 0; overflow: hidden; animation: slideUpFade 0.4s ease-out forwards; display: flex; flex-direction: column;">
    
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-glass); display: flex; gap: 16px; align-items: center; background: #f8fafc;">
        <div style="flex-grow: 1; position: relative;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-secondary);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search by customer name or ID..." class="form-control" style="padding-left: 36px; margin: 0; background: var(--bg-secondary);" />
        </div>
        <div style="position: relative;" @onfocusout="HideDropdown" tabindex="0">
            <div style="display: flex; align-items: center; gap: 10px; background: var(--bg-secondary); padding: 6px 12px; border-radius: 12px; border: 1px solid var(--border-glass); box-shadow: 0 1px 2px rgba(0,0,0,0.05); cursor: pointer;" @onclick="ToggleDropdown">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span style="color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap;">Processed By</span>
                <div style="display: flex; align-items: center; justify-content: space-between; min-width: 140px; padding: 4px 8px; background-color: var(--bg-secondary); border-radius: 6px; font-weight: 500; color: var(--text-primary); box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);">
                    <span>@(selectedEmployee == "All" ? "All Staff" : selectedEmployee)</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s; transform: @(isDropdownOpen ? "rotate(180deg)" : "rotate(0deg)")"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
            </div>
            @if (isDropdownOpen)
            {
                <div style="position: absolute; top: 100%; right: 0; margin-top: 8px; width: 220px; background: var(--bg-secondary); border-radius: 12px; border: 1px solid var(--border-glass); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05); z-index: 50; overflow: hidden; animation: fadeIn 0.15s ease-out;">
                    <div class="custom-dropdown-item @(selectedEmployee == "All" ? "active" : "")" @onclick='() => SelectEmployee("All")'>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--border-glass); display: flex; align-items: center; justify-content: center; color: #4B5563;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>
                            <span>All Staff</span>
                        </div>
                        @if (selectedEmployee == "All") { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                    </div>
                    @foreach (var emp in employees)
                    {
                        <div class="custom-dropdown-item @(selectedEmployee == emp ? "active" : "")" @onclick='() => SelectEmployee(emp)'>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 24px; height: 24px; border-radius: 50%; background: rgba(99, 102, 241, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); font-weight: 600; font-size: 0.7rem;">
                                    @(emp.Substring(0, 1).ToUpper())
                                </div>
                                <span>@emp</span>
                            </div>
                            @if (selectedEmployee == emp) { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (filteredPayments == null)
    {
        <div style="padding: 40px; text-align: center; color: var(--text-secondary);">
            <div class="spinner" style="margin: 0 auto 16px auto;"></div>
            <p>Loading payments...</p>
        </div>
    }
    else if (!filteredPayments.Any())
    {
        <div style="padding: 60px 20px; text-align: center; color: var(--text-secondary); display: flex; flex-direction: column; align-items: center; gap: 12px;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5;"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><line x1="6" y1="8" x2="6" y2="8"></line><line x1="10" y1="8" x2="18" y2="8"></line><line x1="6" y1="12" x2="6" y2="12"></line><line x1="10" y1="12" x2="18" y2="12"></line><line x1="6" y1="16" x2="6" y2="16"></line><line x1="10" y1="16" x2="18" y2="16"></line></svg>
            <p style="font-size: 1.1rem;">No payments recorded yet.</p>
            <button class="btn-primary" @onclick='() => NavManager.NavigateTo("/customers/billinghub")' style="margin-top: 12px; font-size: 0.95rem;">Record the First Payment</button>
        </div>
    }
    else
    {
        <div class="table-scroll-wrapper">
            <table class="premium-table" style="width: 100%; border-collapse: collapse; margin: 0; min-width: 800px;">
                <thead>
                    <tr>
                        <th>Receipt No</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Method</th>
                        <th>Total Amount</th>
                        <th>After Discount</th>
                        <th>Collected</th>
                        <th>Processed By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in displayedPayments)
                    {
                        <tr>
                            <td style="padding: 16px 20px; font-family: monospace; font-weight: 600; color: var(--text-secondary);">@payment.ReceiptNumber</td>
                            <td style="padding: 16px 20px; color: var(--text-primary);">
                                <div style="font-weight: 500;">@payment.PaymentDate.ToString("MMM dd, yyyy")</div>
                                <div style="font-size: 0.8rem; color: var(--text-secondary);">@payment.PaymentDate.ToString("hh:mm tt")</div>
                            </td>
                            <td style="padding: 16px 20px;">
                                <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <div style="font-weight: 800; font-size: 1.05rem; color: var(--text-primary); letter-spacing: 0.5px; text-transform: lowercase;">
                                        @(payment.Customer?.ConnectionId ?? "N/A")
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--text-secondary); font-weight: 500;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                        @(payment.Customer?.Name ?? "Unknown")
                                    </div>
                                </div>
                            </td>
                            <td style="padding: 16px 20px;">
                                <span style="background: #f1f5f9; color: var(--text-secondary); padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">
                                    @(payment.PaymentMethod?.Name ?? "Unknown")
                                </span>
                            </td>
                            <td style="padding: 16px 20px; font-weight: 600; color: var(--text-primary);">Rs. @payment.TotalCharge.ToString("N0")</td>
                            <td style="padding: 16px 20px; font-weight: 600; color: var(--text-secondary);">Rs. @((payment.TotalCharge - payment.Discount).ToString("N0"))</td>
                            <td style="padding: 16px 20px; font-weight: 700; color: var(--accent-success); font-size: 1.1rem;">Rs. @payment.AmountCollected.ToString("N0")</td>
                            <td style="padding: 16px 20px;">
                                <span style="font-size: 0.85rem; color: var(--text-secondary); background: #f1f5f9; padding: 4px 10px; border-radius: 20px; font-weight: 600;">
                                    @(payment.CreatedByName ?? "System")
                                </span>
                            </td>
                            <td style="padding: 16px 20px; text-align: center;">
                                <div style="display: flex; gap: 8px; justify-content: center;">
                                    <button class="btn-icon btn-view" style="color: var(--text-primary);" @onclick='() => NavManager.NavigateTo($"/payments/receipt/{payment.Id}")' title="View Receipt">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                    </button>
                                    <button class="btn-icon btn-edit" style="color: var(--text-primary);" @onclick='() => NavManager.NavigateTo($"/payments/edit/{payment.Id}")' title="Edit Payment">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <AuthorizeView Policy="@IPSDesk.Models.AppPermissions.Payments.Delete">
                                        <Authorized>
                                            <button class="btn-icon btn-delete" style="color: var(--text-primary);" @onclick="() => ConfirmReversePayment(payment)" title="Delete Payment">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination Footer -->
        <div class="premium-pagination-footer">
            <div style="display: flex; align-items: center; gap: 8px; color: var(--text-secondary); font-size: 0.85rem;">
                <select class="form-control" style="width: auto; padding: 4px 8px; margin-bottom: 0; font-size: 0.85rem;" @bind="pageSize" @bind:after="ResetPage">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                </select>
                <span>Showing @(filteredPayments.Any() ? ((currentPage - 1) * pageSize) + 1 : 0) to @(Math.Min(currentPage * pageSize, filteredPayments.Count())) of @(filteredPayments.Count())</span>
            </div>
            @if (totalPages > 1)
            {
                <div style="display: flex; gap: 4px;">
                    <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;" disabled="@(currentPage == 1)" @onclick="() => currentPage--">Prev</button>
                    <span style="padding: 4px 8px; font-size: 0.85rem; font-weight: 600;">@currentPage / @totalPages</span>
                    <button class="btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;" disabled="@(currentPage == totalPages)" @onclick="() => currentPage++">Next</button>
                </div>
            }
        </div>
    }
</div>

@if (isDeleteModalVisible && paymentToDelete != null)
{
    <div class="modal-overlay">
        <div class="glass-panel" style="width: 100%; max-width: 500px; padding: 0; background: var(--bg-secondary); border-radius: 12px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);">
            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid #E5E7EB;">
                <h2 style="margin: 0; font-size: 1.15rem; font-weight: 400; color: var(--text-primary);">Delete Payment</h2>
                <button type="button" @onclick="HideDeleteModal" class="modal-close-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <!-- Body -->
            <div style="padding: 32px 24px; text-align: left;">
                <p style="color: var(--text-secondary); margin: 0 0 16px 0; font-size: 1.05rem;">
                    Are you sure you want to delete this payment for <strong style="color: var(--text-primary);">@(paymentToDelete.Customer?.Name ?? "Unknown")</strong>?
                </p>
                <div style="background: #FEF2F2; border: 1px solid #FCA5A5; padding: 16px; border-radius: 8px;">
                    <h3 style="color: #B91C1C; margin: 0 0 8px 0; font-size: 0.95rem; font-weight: 600;">What will happen:</h3>
                    <ul style="color: #991B1B; margin: 0; padding-left: 16px; font-size: 0.9rem; display: flex; flex-direction: column; gap: 4px;">
                        <li>The customer's balance will be automatically adjusted to reverse this transaction.</li>
                        <li>A new compensatory entry will be added to the customer's ledger for auditing purposes.</li>
                        <li>This payment record will be soft-deleted and removed from this list.</li>
                    </ul>
                </div>
            </div>
            
            <!-- Footer -->
            <div style="display: flex; justify-content: flex-end; gap: 12px; padding: 16px 24px; border-top: 1px solid #E5E7EB; background: var(--bg-secondary);">
                <button type="button" class="modal-cancel-btn" @onclick="HideDeleteModal">Cancel</button>
                <button type="button" class="modal-delete-btn" @onclick="ReversePayment">Delete Payment</button>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .spinner {
        width: 30px;
        height: 30px;
        border: 3px solid rgba(0, 0, 0, 0.1);
        border-radius: 50%;
        border-top-color: var(--accent-primary);
        animation: spin 1s ease-in-out infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private List<Payment>? allPayments;
    private List<Payment>? filteredPayments;
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => filteredPayments == null || !filteredPayments.Any() ? 1 : (int)Math.Ceiling((double)filteredPayments.Count() / pageSize);
    private IEnumerable<Payment> displayedPayments => filteredPayments?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<Payment>();

    private void ResetPage()
    {
        currentPage = 1;
    }

    private List<string> employees = new();
    
    private string _searchTerm = "";
    private string searchTerm 
    {
        get => _searchTerm;
        set 
        {
            _searchTerm = value;
            ApplyFilters();
        }
    }
    
    private string _selectedEmployee = "All";
    private string selectedEmployee 
    {
        get => _selectedEmployee;
        set 
        {
            _selectedEmployee = value;
            ApplyFilters();
        }
    }
    
    private bool isDeleteModalVisible = false;
    private Payment? paymentToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        allPayments = await DbContext.Payments
            .Include(p => p.Customer)
            .Include(p => p.PaymentMethod)
            .Where(p => !p.IsDeleted)
            .OrderByDescending(p => p.PaymentDate)
            .Take(500)
            .ToListAsync();
            
        // Populate distinct employees who processed payments
        employees = allPayments
            .Where(p => !string.IsNullOrEmpty(p.CreatedByName))
            .Select(p => p.CreatedByName!)
            .Distinct()
            .OrderBy(e => e)
            .ToList();
            
        ApplyFilters();
    }
    
    private void ApplyFilters()
    {
        if (allPayments == null) return;
        
        var query = allPayments.AsQueryable();
        
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var lowerSearch = searchTerm.ToLower();
            query = query.Where(p => 
                (p.Customer != null && p.Customer.Name.ToLower().Contains(lowerSearch)) ||
                (p.Customer != null && p.Customer.ConnectionId.ToLower().Contains(lowerSearch)) ||
                (p.ReceiptNumber.ToLower().Contains(lowerSearch))
            );
        }
        
        if (selectedEmployee != "All")
        {
            query = query.Where(p => p.CreatedByName == selectedEmployee);
        }
        
        filteredPayments = query.ToList();
    }

    private bool isDropdownOpen = false;

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private async Task HideDropdown()
    {
        // Small delay to allow click event on items to fire before hiding
        await Task.Delay(150);
        isDropdownOpen = false;
        StateHasChanged();
    }

    private void SelectEmployee(string emp)
    {
        selectedEmployee = emp;
        isDropdownOpen = false;
        ApplyFilters();
    }

    private void ConfirmReversePayment(Payment payment)
    {
        paymentToDelete = payment;
        isDeleteModalVisible = true;
    }

    private void HideDeleteModal()
    {
        isDeleteModalVisible = false;
        paymentToDelete = null;
    }

    private async Task ReversePayment()
    {
        if (paymentToDelete == null) return;
        
        var payment = paymentToDelete;
        HideDeleteModal();

        try
        {
            var dbPayment = await DbContext.Payments.Include(p => p.Customer).FirstOrDefaultAsync(p => p.Id == payment.Id);
            if (dbPayment == null || dbPayment.IsDeleted) return;

            dbPayment.IsDeleted = true;
            dbPayment.UpdatedById = CurrentUserService.UserId;
            dbPayment.UpdatedByName = CurrentUserService.UserName;
            dbPayment.UpdatedAt = DateTime.Now;

            if (dbPayment.Customer != null)
            {
                // Reverse the balance impact: Add AmountCollected, Subtract TotalCharge
                // e.g. Customer owed 1500, paid 1000. Balance became 500.
                // Reversing: Balance + 1000 = 1500. (Since TotalCharge is new items added in payment, reversing means subtracting those).
                decimal balanceAdjustment = dbPayment.AmountCollected - dbPayment.TotalCharge;
                dbPayment.Customer.CurrentBalance += balanceAdjustment;

                // Add compensating ledger entry
                var ledger = new CustomerLedger
                {
                    Id = Guid.NewGuid(),
                    CustomerId = dbPayment.Customer.Id,
                    TransactionDate = DateTime.Now,
                    Description = $"Payment Reversed (Receipt: {dbPayment.ReceiptNumber})",
                    Debit = balanceAdjustment > 0 ? balanceAdjustment : 0,
                    Credit = balanceAdjustment < 0 ? Math.Abs(balanceAdjustment) : 0,
                    Balance = dbPayment.Customer.CurrentBalance
                };
                DbContext.CustomerLedgers.Add(ledger);
                DbContext.Customers.Update(dbPayment.Customer);
            }

            DbContext.Payments.Update(dbPayment);
            await DbContext.SaveChangesAsync();

            ToastService.ShowSuccess($"Payment {payment.ReceiptNumber} reversed successfully.");
            await LoadPayments();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error reversing payment: {ex.Message}");
        }
    }
}

<style>
    .custom-dropdown-item {
        padding: 10px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-primary);
        transition: background-color 0.15s, color 0.15s;
    }
    .custom-dropdown-item:hover {
        background-color: var(--bg-secondary);
    }
    .custom-dropdown-item.active {
        background-color: rgba(99, 102, 241, 0.05);
        color: var(--accent-primary);
    }
    
    .hover-row {
        border-bottom: 1px solid #E5E7EB;
        transition: background-color 0.2s;
    }
    .hover-row:hover {
        background-color: #F8FAFC !important;
    }
</style>





