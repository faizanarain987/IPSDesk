<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["IPSDesk.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.togglePassword = function(button) {
            var container = button.closest('.password-input-container');
            if (!container) {
                // Support wrapping in input-with-icon if used there
                container = button.closest('.input-with-icon');
            }
            if (!container) return;
            
            var input = container.querySelector('input');
            var svgShow = button.querySelector('.eye-icon-show');
            var svgHide = button.querySelector('.eye-icon-hide');
            
            if (input.type === 'password') {
                input.type = 'text';
                if (svgShow) svgShow.style.display = 'none';
                if (svgHide) svgHide.style.display = 'block';
            } else {
                input.type = 'password';
                if (svgShow) svgShow.style.display = 'block';
                if (svgHide) svgHide.style.display = 'none';
            }
        };

        document.addEventListener('click', function (e) {
            var trigger = document.querySelector('.user-profile-trigger');
            var menu = document.querySelector('.profile-dropdown-menu');
            if (menu && trigger && !trigger.contains(e.target) && !menu.contains(e.target)) {
                var backdrop = document.querySelector('.dropdown-backdrop');
                if (backdrop) {
                    backdrop.click();
                }
            }
        });
    </script>
</body>

</html>
